<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Title>Atc.Wpf.Components</Title>
    <PackageId>Atc.Wpf.Components</PackageId>
    <PackageTags>wpf;components;dialogs;viewers;settings;notifications</PackageTags>
    <Description>WPF composite component library providing dialogs, viewers, settings panels, and notifications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS8618;CA1823</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Images\audit.png" />
    <None Remove="Resources\Images\debug.png" />
    <None Remove="Resources\Images\eraser.png" />
    <None Remove="Resources\Images\error.png" />
    <None Remove="Resources\Images\information.png" />
    <None Remove="Resources\Images\scrollrefresh.png" />
    <None Remove="Resources\Images\security.png" />
    <None Remove="Resources\Images\service.png" />
    <None Remove="Resources\Images\trace.png" />
    <None Remove="Resources\Images\ui.png" />
    <None Remove="Resources\Images\warning.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Images\audit.png" />
    <Resource Include="Resources\Images\debug.png" />
    <Resource Include="Resources\Images\eraser.png" />
    <Resource Include="Resources\Images\error.png" />
    <Resource Include="Resources\Images\information.png" />
    <Resource Include="Resources\Images\scrollrefresh.png" />
    <Resource Include="Resources\Images\security.png" />
    <Resource Include="Resources\Images\service.png" />
    <Resource Include="Resources\Images\trace.png" />
    <Resource Include="Resources\Images\ui.png" />
    <Resource Include="Resources\Images\warning.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="3.0.186" />
    <PackageReference Include="Atc.XamlToolkit" Version="3.1.3" />
    <PackageReference Include="Atc.XamlToolkit.Wpf" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atc.Wpf.Controls\Atc.Wpf.Controls.csproj" />
    <ProjectReference Include="..\Atc.Wpf.FontIcons\Atc.Wpf.FontIcons.csproj" />
    <ProjectReference Include="..\Atc.Wpf.Forms\Atc.Wpf.Forms.csproj" />
    <ProjectReference Include="..\Atc.Wpf.Theming\Atc.Wpf.Theming.csproj" />
    <ProjectReference Include="..\Atc.Wpf\Atc.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\DualListSelector.Designer.cs">
      <DependentUpon>DualListSelector.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Resources\JsonViewer.Designer.cs">
      <DependentUpon>JsonViewer.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Resources\Miscellaneous.Designer.cs">
      <DependentUpon>Miscellaneous.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Resources\TerminalViewer.Designer.cs">
      <DependentUpon>TerminalViewer.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\DualListSelector.da-DK.resx">
      <SubType>Designer</SubType>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\DualListSelector.de-DE.resx">
