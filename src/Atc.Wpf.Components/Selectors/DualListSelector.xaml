<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcResources="clr-namespace:Atc.Wpf.Resources;assembly=Atc.Wpf"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:buttonControls="clr-namespace:Atc.Wpf.Controls.Buttons;assembly=Atc.Wpf.Controls"
    xmlns:resources="clr-namespace:Atc.Wpf.Components.Resources"
    xmlns:selectors="clr-namespace:Atc.Wpf.Components.Selectors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Atc.Wpf.Controls;component/Buttons/ImageButton.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="AtcApps.DataTemplate.DualListSelectorItem" DataType="{x:Type selectors:DualListSelectorItem}">
        <StackPanel Margin="4,2">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource AtcApps.Brushes.Text}"
                Text="{Binding Path=Name}" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource AtcApps.Brushes.Gray6}"
                Text="{Binding Path=Description}"
                Visibility="{Binding Path=Description, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}" />
        </StackPanel>
    </DataTemplate>

    <!--  The x button of a selected row in one-way mode  -->
    <Style x:Key="AtcApps.Styles.DualListSelector.RemoveButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource AtcApps.Brushes.Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Ellipse
                            x:Name="circle"
                            Width="18"
                            Height="18"
                            Fill="Transparent" />
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 0,0 L 7,7 M 0,7 L 7,0"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeThickness="1.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="circle" Property="Fill" Value="{DynamicResource AtcApps.Brushes.Gray8}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="circle" Property="Fill" Value="{DynamicResource AtcApps.Brushes.Gray6}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Row wrappers: the check box (CheckBox style), the lock icon and the x button (one-way) sit around
        the item template (ItemTemplate, or the default one), so a custom ItemTemplate keeps them.
    -->
    <DataTemplate x:Key="AtcApps.DataTemplate.DualListSelector.AvailableRow" DataType="{x:Type selectors:DualListSelectorItem}">
        <DockPanel>
            <CheckBox
                x:Name="RowCheckBox"
                Margin="4,0,2,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Path=Name}"
                DockPanel.Dock="Left"
                Focusable="False"
                IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}"
                Visibility="Collapsed" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{Binding Path=(selectors:DualListSelector.RowItemTemplate), RelativeSource={RelativeSource Self}, TargetNullValue={StaticResource AtcApps.DataTemplate.DualListSelectorItem}}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(selectors:DualListSelector.RowSelectionStyle), ElementName=RowCheckBox}" Value="CheckBox">
                <Setter TargetName="RowCheckBox" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AtcApps.DataTemplate.DualListSelector.SelectedRow" DataType="{x:Type selectors:DualListSelectorItem}">
        <DockPanel>
            <CheckBox
                x:Name="RowCheckBox"
                Margin="4,0,2,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Path=Name}"
                DockPanel.Dock="Left"
                Focusable="False"
                IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}"
                Visibility="Collapsed" />
            <Button
                x:Name="RemoveButton"
                Margin="4,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Path=Name, StringFormat={x:Static atcResources:Miscellaneous.Remove1}}"
                Command="{x:Static selectors:DualListSelectorCommands.RemoveFromSelected}"
                CommandParameter="{Binding}"
                DockPanel.Dock="Right"
                Style="{StaticResource AtcApps.Styles.DualListSelector.RemoveButton}"
                ToolTip="{Binding Path=Name, StringFormat={x:Static atcResources:Miscellaneous.Remove1}}"
                Visibility="Collapsed" />
            <Path
                x:Name="LockIcon"
                Width="12"
                Height="12"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static resources:DualListSelector.Locked}"
                Data="M 4,7 L 4,4.5 A 3,3 0 0 1 10,4.5 L 10,7 L 8.5,7 L 8.5,4.5 A 1.5,1.5 0 0 0 5.5,4.5 L 5.5,7 Z M 2,7 L 12,7 L 12,14 L 2,14 Z"
                DockPanel.Dock="Right"
                Fill="{DynamicResource AtcApps.Brushes.Gray6}"
                Stretch="Uniform"
                ToolTip="{x:Static resources:DualListSelector.Locked}"
                Visibility="Collapsed" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{Binding Path=(selectors:DualListSelector.RowItemTemplate), RelativeSource={RelativeSource Self}, TargetNullValue={StaticResource AtcApps.DataTemplate.DualListSelectorItem}}" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=(selectors:DualListSelector.RowSelectionStyle), ElementName=RowCheckBox}" Value="CheckBox">
                <Setter TargetName="RowCheckBox" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=IsLocked}" Value="True">
                <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(selectors:DualListSelector.RowIsOneWay), ElementName=RowCheckBox}" Value="True" />
                    <Condition Binding="{Binding Path=IsLocked}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="AtcApps.DataTemplate.DualListSelector.GroupHeader">
        <TextBlock
            Margin="4,6,4,2"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AtcApps.Brushes.Gray6}"
            Text="{Binding Path=Name}" />
    </DataTemplate>

    <Style
        x:Key="AtcApps.Styles.DualListSelector.ImageButton"
        BasedOn="{StaticResource AtcApps.Styles.ImageButton}"
        TargetType="{x:Type buttonControls:ImageButton}">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="ImageLocation" Value="Center" />
        <Setter Property="SvgImageOverrideColor" Value="{DynamicResource AtcApps.Colors.Accent}" />
    </Style>

    <Style
        x:Key="AtcApps.Styles.DualListSelector.ItemContainer"
        BasedOn="{StaticResource AtcApps.Styles.ListBoxItem}"
        TargetType="{x:Type ListBoxItem}">
        <Setter Property="atc:ItemHelper.ActiveSelectionBackgroundBrush" Value="{DynamicResource AtcApps.Brushes.Accent}" />
        <Setter Property="atc:ItemHelper.ActiveSelectionForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Selected.Foreground}" />
        <Setter Property="atc:ItemHelper.DisabledForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Gray}" />
        <Setter Property="atc:ItemHelper.DisabledSelectedBackgroundBrush" Value="{DynamicResource AtcApps.Brushes.Gray7}" />
        <Setter Property="atc:ItemHelper.DisabledSelectedForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Selected.Foreground}" />
        <Setter Property="atc:ItemHelper.HoverBackgroundBrush" Value="{DynamicResource AtcApps.Brushes.Accent3}" />
        <Setter Property="atc:ItemHelper.HoverForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Text}" />
        <Setter Property="atc:ItemHelper.HoverSelectedBackgroundBrush" Value="{DynamicResource AtcApps.Brushes.Accent}" />
        <Setter Property="atc:ItemHelper.HoverSelectedForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Selected.Foreground}" />
        <Setter Property="atc:ItemHelper.SelectedBackgroundBrush" Value="{DynamicResource AtcApps.Brushes.Accent2}" />
        <Setter Property="atc:ItemHelper.SelectedForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Selected.Foreground}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
            <!--  CheckBox style: the check box shows the pick, so picked rows are not highlighted  -->
            <Trigger Property="selectors:DualListSelector.RowSelectionStyle" Value="CheckBox">
                <Setter Property="atc:ItemHelper.ActiveSelectionBackgroundBrush" Value="Transparent" />
                <Setter Property="atc:ItemHelper.ActiveSelectionForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Text}" />
                <Setter Property="atc:ItemHelper.SelectedBackgroundBrush" Value="Transparent" />
                <Setter Property="atc:ItemHelper.SelectedForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Text}" />
                <Setter Property="atc:ItemHelper.HoverSelectedBackgroundBrush" Value="{DynamicResource AtcApps.Brushes.Accent3}" />
                <Setter Property="atc:ItemHelper.HoverSelectedForegroundBrush" Value="{DynamicResource AtcApps.Brushes.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtcApps.Styles.DualListSelector" TargetType="{x:Type selectors:DualListSelector}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type selectors:DualListSelector}">
                    <atc:GridEx Columns="Auto,*,Auto,*,Auto">

                        <!--  Available List Panel  -->
                        <DockPanel x:Name="AvailablePanel" Grid.Column="1">
                            <ContentPresenter
                                x:Name="AvailableHeaderPresenter"
                                Margin="0,0,0,4"
                                Content="{TemplateBinding AvailableHeader}"
                                ContentTemplate="{TemplateBinding AvailableHeaderTemplate}"
                                DockPanel.Dock="Top"
                                Visibility="{Binding AvailableHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}" />
                            <DockPanel
                                x:Name="AvailableSelectAllRow"
                                Margin="4,0,0,4"
                                DockPanel.Dock="Top"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_AvailableHeaderCount"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="AvailableHeaderCount"
                                    DockPanel.Dock="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource AtcApps.Brushes.Gray6}" />
                                <CheckBox
                                    x:Name="PART_AvailableSelectAll"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="AvailableSelectAll"
                                    Content="{x:Static atcResources:Miscellaneous.SelectAll}" />
                            </DockPanel>
                            <TextBox
                                x:Name="PART_AvailableFilterTextBox"
                                Margin="0,0,0,4"
                                AutomationProperties.AutomationId="AvailableFilter"
                                atc:TextBoxHelper.ClearTextButton="True"
                                atc:TextBoxHelper.Watermark="{x:Static resources:DualListSelector.FilterPlaceholder}"
                                DockPanel.Dock="Top"
                                Visibility="{Binding ShowFilter, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                            <TextBlock
                                x:Name="PART_AvailableItemCount"
                                Margin="0,4,0,0"
                                AutomationProperties.AutomationId="AvailableItemCount"
                                DockPanel.Dock="Bottom"
                                FontSize="11"
                                Foreground="{DynamicResource AtcApps.Brushes.Gray6}"
                                Visibility="Collapsed" />
                            <ContentPresenter
                                x:Name="AvailableFooterPresenter"
                                Content="{TemplateBinding AvailableFooter}"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding AvailableFooter, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}" />
                            <Grid>
                                <ListBox
                                    x:Name="PART_AvailableListBox"
                                    AutomationProperties.AutomationId="AvailableList"
                                    MinWidth="{TemplateBinding ListMinWidth}"
                                    MinHeight="{TemplateBinding ListMinHeight}"
                                    MaxHeight="{TemplateBinding ListMaxHeight}"
                                    AllowDrop="{Binding AllowDragDrop, RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="{Binding AvailableHeader, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='Available items'}"
                                    Background="{DynamicResource AtcApps.Brushes.Control.Background}"
                                    BorderBrush="{DynamicResource AtcApps.Brushes.Gray6}"
                                    BorderThickness="1"
                                    ItemContainerStyle="{StaticResource AtcApps.Styles.DualListSelector.ItemContainer}"
                                    ItemTemplate="{StaticResource AtcApps.DataTemplate.DualListSelector.AvailableRow}"
                                    ScrollViewer.CanContentScroll="True"
                                    SelectionMode="Extended"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.GroupStyle>
                                        <GroupStyle HeaderTemplate="{StaticResource AtcApps.DataTemplate.DualListSelector.GroupHeader}" />
                                    </ListBox.GroupStyle>
                                </ListBox>
                                <TextBlock
                                    x:Name="PART_AvailableEmptyText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource AtcApps.Brushes.Gray6}"
                                    IsHitTestVisible="False"
                                    AutomationProperties.AutomationId="NoMatches"
                                    Text="{x:Static atcResources:Miscellaneous.NoMatches}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>

                        <!--  Transfer Buttons  -->
                        <StackPanel
                            x:Name="TransferButtonPanel"
                            Grid.Column="2"
                            Width="{TemplateBinding ButtonAreaWidth}"
                            Margin="6,0"
                            VerticalAlignment="Center">
                            <buttonControls:ImageButton
                                x:Name="MoveAllToSelectedButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveAllToSelected}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveAllToSelected}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/chevron_double_right.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveAllToSelected}"
                                Visibility="{Binding ShowTransferAllButtons, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                            <buttonControls:ImageButton
                                x:Name="MoveToSelectedButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveToSelected}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveToSelected}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/chevron_right.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveToSelected}" />
                            <buttonControls:ImageButton
                                x:Name="MoveToAvailableButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveToAvailable}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveToAvailable}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/chevron_left.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveToAvailable}" />
                            <buttonControls:ImageButton
                                x:Name="MoveAllToAvailableButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveAllToAvailable}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveAllToAvailable}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/chevron_double_left.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveAllToAvailable}"
                                Visibility="{Binding ShowTransferAllButtons, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                        </StackPanel>

                        <!--  Selected List Panel  -->
                        <DockPanel x:Name="SelectedPanel" Grid.Column="3">
                            <ContentPresenter
                                x:Name="SelectedHeaderPresenter"
                                Margin="0,0,0,4"
                                Content="{TemplateBinding SelectedHeader}"
                                ContentTemplate="{TemplateBinding SelectedHeaderTemplate}"
                                DockPanel.Dock="Top"
                                Visibility="{Binding SelectedHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}" />
                            <DockPanel
                                x:Name="SelectedSelectAllRow"
                                Margin="4,0,0,4"
                                DockPanel.Dock="Top"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_SelectedHeaderCount"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="SelectedHeaderCount"
                                    DockPanel.Dock="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource AtcApps.Brushes.Gray6}" />
                                <CheckBox
                                    x:Name="PART_SelectedSelectAll"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="SelectedSelectAll"
                                    Content="{x:Static atcResources:Miscellaneous.SelectAll}" />
                            </DockPanel>
                            <TextBox
                                x:Name="PART_SelectedFilterTextBox"
                                Margin="0,0,0,4"
                                AutomationProperties.AutomationId="SelectedFilter"
                                atc:TextBoxHelper.ClearTextButton="True"
                                atc:TextBoxHelper.Watermark="{x:Static resources:DualListSelector.FilterPlaceholder}"
                                DockPanel.Dock="Top"
                                Visibility="{Binding ShowFilter, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                            <TextBlock
                                x:Name="PART_SelectedItemCount"
                                Margin="0,4,0,0"
                                AutomationProperties.AutomationId="SelectedItemCount"
                                DockPanel.Dock="Bottom"
                                FontSize="11"
                                Foreground="{DynamicResource AtcApps.Brushes.Gray6}"
                                Visibility="Collapsed" />
                            <ContentPresenter
                                x:Name="SelectedFooterPresenter"
                                Content="{TemplateBinding SelectedFooter}"
                                DockPanel.Dock="Bottom"
                                Visibility="{Binding SelectedFooter, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}" />
                            <Grid>
                                <ListBox
                                    x:Name="PART_SelectedListBox"
                                    AutomationProperties.AutomationId="SelectedList"
                                    MinWidth="{TemplateBinding ListMinWidth}"
                                    MinHeight="{TemplateBinding ListMinHeight}"
                                    MaxHeight="{TemplateBinding ListMaxHeight}"
                                    AllowDrop="{Binding AllowDragDrop, RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="{Binding SelectedHeader, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='Selected items'}"
                                    Background="{DynamicResource AtcApps.Brushes.Control.Background}"
                                    BorderBrush="{DynamicResource AtcApps.Brushes.Gray6}"
                                    BorderThickness="1"
                                    ItemContainerStyle="{StaticResource AtcApps.Styles.DualListSelector.ItemContainer}"
                                    ItemTemplate="{StaticResource AtcApps.DataTemplate.DualListSelector.SelectedRow}"
                                    ScrollViewer.CanContentScroll="True"
                                    SelectionMode="Extended"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.GroupStyle>
                                        <GroupStyle HeaderTemplate="{StaticResource AtcApps.DataTemplate.DualListSelector.GroupHeader}" />
                                    </ListBox.GroupStyle>
                                </ListBox>
                                <TextBlock
                                    x:Name="PART_SelectedEmptyText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource AtcApps.Brushes.Gray6}"
                                    IsHitTestVisible="False"
                                    AutomationProperties.AutomationId="NoMatches"
                                    Text="{x:Static atcResources:Miscellaneous.NoMatches}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>

                        <!--  Reorder Buttons  -->
                        <StackPanel
                            x:Name="ReorderButtonPanel"
                            Grid.Column="4"
                            Width="{TemplateBinding ButtonAreaWidth}"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowReorderButtons, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                            <buttonControls:ImageButton
                                x:Name="MoveToTopButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveToTop}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveToTop}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/arrow_top.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveToTop}" />
                            <buttonControls:ImageButton
                                x:Name="MoveUpButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveUp}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveUp}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/arrow_up.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveUp}" />
                            <buttonControls:ImageButton
                                x:Name="MoveDownButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveDown}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveDown}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/arrow_down.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveDown}" />
                            <buttonControls:ImageButton
                                x:Name="MoveToBottomButton"
                                AutomationProperties.Name="{x:Static resources:DualListSelector.MoveToBottom}"
                                Command="{x:Static selectors:DualListSelectorCommands.MoveToBottom}"
                                Style="{StaticResource AtcApps.Styles.DualListSelector.ImageButton}"
                                SvgImageSource="/Atc.Wpf.Controls;component/Resources/Icons/arrow_bottom.svg"
                                ToolTip="{x:Static resources:DualListSelector.MoveToBottom}" />
                        </StackPanel>
                    </atc:GridEx>
                    <ControlTemplate.Triggers>
                        <!--  SelectedFirst layout: swap columns and arrow directions  -->
                        <Trigger Property="LayoutMode" Value="SelectedFirst">
                            <Setter TargetName="ReorderButtonPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="SelectedPanel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="TransferButtonPanel" Property="Grid.Column" Value="2" />
                            <Setter TargetName="AvailablePanel" Property="Grid.Column" Value="3" />
                            <Setter TargetName="MoveAllToSelectedButton" Property="SvgImageSource" Value="/Atc.Wpf.Controls;component/Resources/Icons/chevron_double_left.svg" />
                            <Setter TargetName="MoveToSelectedButton" Property="SvgImageSource" Value="/Atc.Wpf.Controls;component/Resources/Icons/chevron_left.svg" />
                            <Setter TargetName="MoveToAvailableButton" Property="SvgImageSource" Value="/Atc.Wpf.Controls;component/Resources/Icons/chevron_right.svg" />
                            <Setter TargetName="MoveAllToAvailableButton" Property="SvgImageSource" Value="/Atc.Wpf.Controls;component/Resources/Icons/chevron_double_right.svg" />
                        </Trigger>
                        <!--  CheckBox style: a "Select all" row per list, and a plain click toggles a row  -->
                        <Trigger Property="ItemSelectionStyle" Value="CheckBox">
                            <Setter TargetName="AvailableSelectAllRow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectedSelectAllRow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_AvailableListBox" Property="SelectionMode" Value="Multiple" />
                            <Setter TargetName="PART_SelectedListBox" Property="SelectionMode" Value="Multiple" />
                        </Trigger>
                        <!--  One-way: no "move back" buttons; each selected row has an x button instead  -->
                        <Trigger Property="IsOneWay" Value="True">
                            <Setter TargetName="MoveToAvailableButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MoveAllToAvailableButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!--  AllowMultiSelect: switch to single selection mode  -->
                        <Trigger Property="AllowMultiSelect" Value="False">
                            <Setter TargetName="PART_AvailableListBox" Property="SelectionMode" Value="Single" />
                            <Setter TargetName="PART_SelectedListBox" Property="SelectionMode" Value="Single" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Default header style for string content  -->
    <DataTemplate
        xmlns:system="clr-namespace:System;assembly=mscorlib"
