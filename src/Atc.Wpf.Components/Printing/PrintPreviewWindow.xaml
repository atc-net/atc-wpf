<theming:NiceWindow
    x:Class="Atc.Wpf.Components.Printing.PrintPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theming="clr-namespace:Atc.Wpf.Theming.Controls.Windows;assembly=Atc.Wpf.Theming"
    Title="{atcTranslation:Resx ResxName=Atc.Wpf.Components.Resources.Miscellaneous, Key=PrintPreview}"
    Width="900"
    Height="700"
    MinWidth="600"
    MinHeight="400"
    ShowMaxRestoreButton="True"
    ShowMinButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel>

        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">
                <Button
                    x:Name="PrintButton"
                    Padding="8,4"
                    Click="PrintButton_Click"
                    Content="{atcTranslation:Resx ResxName=Atc.Wpf.Resources.Word, Key=Print}"
                    ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Components.Resources.Miscellaneous, Key=SendToPrinter}" />
                <Separator />
                <Button
                    x:Name="CloseButton"
                    Padding="8,4"
                    Click="CloseButton_Click"
                    Content="{atcTranslation:Resx ResxName=Atc.Wpf.Resources.Word, Key=Close}"
                    ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Components.Resources.Miscellaneous, Key=ClosePreview}" />
            </ToolBar>
        </ToolBarTray>

        <DocumentViewer x:Name="PreviewViewer" Background="{DynamicResource AtcApps.Brushes.ThemeBackground}" />

    </DockPanel>

</theming:NiceWindow>