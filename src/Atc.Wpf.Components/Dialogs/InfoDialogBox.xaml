<dialogs:NiceDialogBox
    x:Class="Atc.Wpf.Components.Dialogs.InfoDialogBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Atc.Wpf.Theming.Themes.Dialogs;assembly=Atc.Wpf.Theming"
    xmlns:formsDialogs="clr-namespace:Atc.Wpf.Forms.Dialogs;assembly=Atc.Wpf.Forms"
    xmlns:local="clr-namespace:Atc.Wpf.Components.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Path=Settings.TitleBarText}"
    d:DataContext="{d:DesignInstance Type=local:InfoDialogBox,
                                     IsDesignTimeCreatable=True}"
    d:Height="200"
    d:Width="350"
    mc:Ignorable="d">

    <DockPanel>

        <Border
            x:Name="ContentTop"
            MinHeight="50"
            Background="{DynamicResource AtcApps.Brushes.ThemeBackground1}"
            BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            Visibility="{Binding Path=HeaderControl, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}">
            <ContentControl Content="{Binding Path=HeaderControl}" />
        </Border>

        <Border
            x:Name="ContentButton"
            Height="50"
            Background="{DynamicResource AtcApps.Brushes.ThemeBackground1}"
            BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <formsDialogs:DialogBoxButtonBar
                ButtonClicked="OnButtonClicked"
                CopyClicked="OnCopyClicked"
                Settings="{Binding Path=Settings}" />
        </Border>

        <ScrollViewer
            Padding="30"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding Path=ContentControl}" />
        </ScrollViewer>

    </DockPanel>

</dialogs:NiceDialogBox>