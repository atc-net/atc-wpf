<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flyouts="clr-namespace:Atc.Wpf.Components.Flyouts">

    <!--
        Default (theme) styles, used when the application merges no Atc.Wpf.Components styles.
        Merging Styles/Controls.xaml in the application still works and takes precedence.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Atc.Wpf.Components;component/Flyouts/Flyout.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Atc.Wpf.Components;component/Flyouts/FlyoutHost.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource AtcApps.Styles.Flyout}" TargetType="{x:Type flyouts:Flyout}" />
    <Style BasedOn="{StaticResource AtcApps.Styles.FlyoutHost}" TargetType="{x:Type flyouts:FlyoutHost}" />
    <Style BasedOn="{StaticResource AtcApps.Styles.FlyoutPresenter}" TargetType="{x:Type flyouts:FlyoutPresenter}" />

</ResourceDictionary>
