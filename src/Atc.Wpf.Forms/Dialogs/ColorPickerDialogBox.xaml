<dialogs:NiceDialogBox
    x:Class="Atc.Wpf.Forms.Dialogs.ColorPickerDialogBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:colorEditing="clr-namespace:Atc.Wpf.Forms.ColorEditing"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Atc.Wpf.Theming.Themes.Dialogs;assembly=Atc.Wpf.Theming"
    xmlns:local="clr-namespace:Atc.Wpf.Forms.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Path=Settings.TitleBarText}"
    d:DataContext="{d:DesignInstance Type=local:ColorPickerDialogBox,
                                     IsDesignTimeCreatable=True}"
    d:Height="720"
    d:Width="730"
    mc:Ignorable="d">

    <DockPanel>

        <Border
            MinHeight="50"
            Background="{DynamicResource AtcApps.Brushes.ThemeBackground1}"
            BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top"
            Visibility="{Binding Path=HeaderControl, Converter={x:Static atcValueConverters:ObjectNotNullToVisibilityVisibleValueConverter.Instance}}">
            <ContentControl
                Margin="30,5"
                VerticalAlignment="Center"
                Content="{Binding Path=HeaderControl}" />
        </Border>

        <Border
            Height="50"
            Background="{DynamicResource AtcApps.Brushes.ThemeBackground1}"
            BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <local:DialogBoxButtonBar ButtonClicked="OnButtonClicked" Settings="{Binding Path=Settings}" />
        </Border>

        <ScrollViewer
            Padding="30"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <colorEditing:AdvancedColorPicker x:Name="UcAdvancedColorPicker" />
        </ScrollViewer>

    </DockPanel>

</dialogs:NiceDialogBox>