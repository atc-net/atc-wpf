<UserControl
    x:Class="Atc.Wpf.Hardware.Pickers.DisplayPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="clr-namespace:Atc.Wpf.ValueConverters;assembly=Atc.Wpf"
    xmlns:converters="clr-namespace:Atc.Wpf.Hardware.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Hardware.Pickers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Atc.Wpf.Hardware.Models"
    d:DataContext="{d:DesignInstance Type=local:DisplayPicker}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Atc.Wpf.Hardware;component/Pickers/Internal/PickerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="DefaultItemTemplate" DataType="{x:Type models:DisplayInfo}">
                <atc:GridEx VerticalAlignment="Center" Columns="Auto,8,*,8,Auto">
                    <Control Grid.Column="0" Style="{StaticResource AtcApps.Hardware.PickerStatusDot}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Text="{Binding}" />
                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        Foreground="{DynamicResource AtcApps.Brushes.Gray5}"
                        Text="{Binding State, Converter={x:Static converters:DeviceStateToTextConverter.Instance}}" />
                </atc:GridEx>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <atc:GridEx Columns="*,4,Auto" Rows="Auto,Auto">
        <ComboBox
            x:Name="PartComboBox"
            Grid.Row="0"
            Grid.Column="0"
            atc:TextBoxHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayPicker}, Path=WatermarkText}"
            ItemTemplate="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayPicker}, Path=ResolvedItemTemplate}"
            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayPicker}, Path=Displays}"
            SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayPicker}, Path=Value, Mode=TwoWay}" />

        <Button
            Grid.Row="0"
            Grid.Column="2"
            Click="OnRefreshClick"
            Style="{StaticResource AtcApps.Hardware.PickerRefreshButton}"
            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayPicker}, Path=ShowRefreshButton, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,4,0,0"
            FontStyle="Italic"
            Foreground="{DynamicResource AtcApps.Brushes.Accent}"
            Text="{Binding RelativeSource={RelativeSource AncestorType=local:DisplayPicker}, Path=SelectedStateMessage}">
            <TextBlock.Visibility>
                <MultiBinding Converter="{x:Static atcValueConverters:MultiBoolToVisibilityVisibleValueConverter.Instance}">
                    <Binding Path="HasSelectedStateMessage" RelativeSource="{RelativeSource AncestorType=local:DisplayPicker}" />
                    <Binding Path="ShowSelectedStateMessage" RelativeSource="{RelativeSource AncestorType=local:DisplayPicker}" />
                </MultiBinding>
            </TextBlock.Visibility>
        </TextBlock>
    </atc:GridEx>
</UserControl>