<UserControl
    x:Class="Atc.Wpf.Controls.Sample.SampleExplorer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Controls.Sample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="800"
    d:DesignWidth="1400"
    mc:Ignorable="d">

    <atc:GridEx
        Margin="0,1,0,0"
        Columns="500,5,*"
        Rows="*,Auto">

        <DockPanel Grid.Row="0" Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                <TextBox
                    x:Name="FilterTextBox"
                    Margin="8,20,5,10"
                    AutomationProperties.AutomationId="TbSampleFilter"
                    atc:TextBoxHelper.ClearTextButton="True"
                    atc:TextBoxHelper.Watermark="Filter"
                    Focusable="True"
                    TextChanged="FilterOnTextChanged">
                    <TextBox.ToolTip>
                        <TextBlock>
                            <Run FontWeight="Bold">Filter Samples</Run>
                            <LineBreak />
                            <LineBreak />
                            <Run FontWeight="SemiBold">Text search</Run>
                            <Run>(case-insensitive)</Run>
                            <LineBreak />
                            <Run>button    → AuthenticationButton, ImageButton, ...</Run>
                            <LineBreak />
                            <LineBreak />
                            <Run FontWeight="SemiBold">PascalCase initials</Run>
                            <Run>(2+ uppercase letters)</Run>
                            <LineBreak />
                            <Run>NW        → NiceWindow</Run>
                            <LineBreak />
                            <Run>TS        → ToggleSwitch, ThemeSelector, ...</Run>
                        </TextBlock>
                    </TextBox.ToolTip>
                </TextBox>
                <atc:UniformSpacingPanel
                    Margin="10,5,5,15"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button Click="ExpandAllOnClick" ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Resources.Miscellaneous, Key=ExpandAll}">
                        <atc:SvgImage
                            Width="16"
                            Height="16"
                            OverrideColor="DarkOrange"
                            Source="/Atc.Wpf.Controls;component/Resources/Icons/expand.svg" />
                    </Button>
                    <Button Click="CollapseAllOnClick" ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Resources.Miscellaneous, Key=CollapseAll}">
                        <atc:SvgImage
                            Width="16"
                            Height="16"
                            OverrideColor="DarkOrange"
                            Source="/Atc.Wpf.Controls;component/Resources/Icons/collapse.svg" />
                    </Button>
                </atc:UniformSpacingPanel>
            </StackPanel>

            <!--  The category tabs (headers only) on the left, the sample trees on the right  -->
            <atc:GridEx
                Margin="0,0,5,10"
                Columns="Auto,*"
                DockPanel.Dock="Bottom">
                <TabControl
                    x:Name="CategoryTabControl"
                    Grid.Column="0"
                    atc:TabControlHelper.UnderlineMargin="0"
                    atc:TabControlHelper.UnderlinePlacement="Left"
                    atc:TabControlHelper.Underlined="SelectedTabItem"
                    AutomationProperties.AutomationId="SamplesTabControl"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    SelectionChanged="TabControlOnSelectionChanged"
                    TabStripPlacement="Left" />

                <Border
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Padding="2"
                    BorderBrush="{DynamicResource AtcApps.Brushes.Gray8}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!--  The category and sample item styles are set on this panel only (in code), so they don't reach the sample pages  -->
                        <StackPanel x:Name="TreePanel" />
                    </ScrollViewer>
                </Border>
            </atc:GridEx>
        </DockPanel>

        <atc:GridEx
            Grid.Row="0"
            Grid.Column="2"
            Margin="10"
            Columns="*,10,Auto,Auto"
            Rows="Auto,*">
            <!--  The selectors hide their (empty) validation row, so their drop-downs line up with the check box  -->
            <CheckBox
                x:Name="RightToLeftCheckBox"
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SampleRightToLeft"
                Content="Right to left"
                IsChecked="{Binding ElementName=SampleViewer, Path=IsSampleRightToLeft}"
                ToolTip="Show the sample in a right-to-left layout, as for Arabic or Hebrew" />
            <atc:LabelLanguageSelector
                x:Name="LanguageSelector"
                Grid.Row="0"
                Grid.Column="2"
                Width="250"
                VerticalAlignment="Center"
                HideAreas="Validation"
                LabelWidthNumber="80"
                LabelWidthSizeDefinition="Pixel"
                Orientation="Horizontal" />
            <atc:LabelThemeAndAccentColorSelectors
                x:Name="ThemeAndAccentSelectors"
                Grid.Row="0"
                Grid.Column="3"
                Width="500"
                VerticalAlignment="Center"
                HideAreas="Validation"
                LabelWidthNumber="50"
                LabelWidthSizeDefinition="Pixel" />
            <local:SampleViewerView
                x:Name="SampleViewer"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Foreground="{DynamicResource AtcApps.Brushes.Text}"
                HeaderForeground="{DynamicResource AtcApps.Brushes.Accent}" />
        </atc:GridEx>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" />
            </StatusBarItem>
        </StatusBar>
    </atc:GridEx>

</UserControl>