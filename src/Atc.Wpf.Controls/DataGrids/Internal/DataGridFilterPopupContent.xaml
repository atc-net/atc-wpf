<UserControl
    x:Class="Atc.Wpf.Controls.DataGrids.Internal.DataGridFilterPopupContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:Atc.Wpf.Controls.Selectors"
    Width="270"
    x:ClassModifier="internal"
    Foreground="{DynamicResource AtcApps.Brushes.Text}"
    d:DesignHeight="380"
    d:DesignWidth="270"
    mc:Ignorable="d">

    <Border
        Padding="8"
        Background="{DynamicResource AtcApps.Brushes.ThemeBackground}"
        BorderBrush="{DynamicResource AtcApps.Brushes.ComboBox.PopupBorder}"
        BorderThickness="1"
        SnapsToDevicePixels="True">
        <DockPanel>

            <!--  Filter mode: values (default), text, range (number and date columns)  -->
            <WrapPanel Margin="0,0,0,8" DockPanel.Dock="Top">
                <RadioButton
                    x:Name="PartValuesMode"
                    Margin="0,0,12,0"
                    AutomationProperties.AutomationId="FilterValuesMode"
                    Checked="OnModeChecked"
                    IsChecked="True" />
                <RadioButton
                    x:Name="PartTextMode"
                    Margin="0,0,12,0"
                    AutomationProperties.AutomationId="FilterTextMode"
                    Checked="OnModeChecked" />
                <RadioButton
                    x:Name="PartRangeMode"
                    AutomationProperties.AutomationId="FilterRangeMode"
                    Checked="OnModeChecked"
                    Visibility="Collapsed" />
            </WrapPanel>

            <!--  Clear filter, OK, Cancel  -->
            <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                <Button
                    x:Name="PartClearButton"
                    Padding="8,1"
                    AutomationProperties.AutomationId="ClearFilter"
                    Click="OnClearClick"
                    DockPanel.Dock="Left" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="PartOkButton"
                        MinWidth="56"
                        Padding="8,1"
                        AutomationProperties.AutomationId="Ok"
                        Click="OnOkClick" />
                    <Button
                        x:Name="PartCancelButton"
                        MinWidth="56"
                        Margin="6,0,0,0"
                        Padding="8,1"
                        AutomationProperties.AutomationId="Cancel"
                        Click="OnCancelClick" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <selectors:CheckListBox
                    x:Name="PartValues"
                    Height="260"
                    AutomationProperties.AutomationId="FilterValues"
                    IsFilterVisible="True" />

                <StackPanel x:Name="PartTextPanel" Visibility="Collapsed">
                    <ComboBox x:Name="PartTextOperator" AutomationProperties.AutomationId="FilterTextOperator" />
                    <TextBox
                        x:Name="PartText"
                        Margin="0,6,0,0"
                        AutomationProperties.AutomationId="FilterText" />
                </StackPanel>

                <Grid x:Name="PartRangePanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="PartFromLabel"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                    <TextBox
                        x:Name="PartFrom"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="FilterFrom" />
                    <TextBlock
                        x:Name="PartToLabel"
                        Grid.Row="1"
                        Margin="0,6,8,0"
                        VerticalAlignment="Center" />
                    <TextBox
                        x:Name="PartTo"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,6,0,0"
                        AutomationProperties.AutomationId="FilterTo" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
