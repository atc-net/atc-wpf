<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:navigation="clr-namespace:Atc.Wpf.Controls.Navigation">

    <Geometry x:Key="AtcApps.Geometries.NavigationView.Hamburger">M0,0 L16,0 M0,5 L16,5 M0,10 L16,10</Geometry>
    <Geometry x:Key="AtcApps.Geometries.NavigationView.Back">M7,0 L0,6 L7,12 M0,6 L16,6</Geometry>

    <!--  Pane button (hamburger / back)  -->
    <Style x:Key="AtcApps.Styles.NavigationView.PaneButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource AtcApps.Brushes.Text}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource AtcApps.Brushes.Gray9}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  NavigationViewItem style  -->
    <Style x:Key="AtcApps.Styles.NavigationViewItem" TargetType="{x:Type navigation:NavigationViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource AtcApps.Brushes.Text}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type navigation:NavigationViewItem}">
                    <Border
                        x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
                        BorderThickness="0"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!--  The icon column matches the compact pane, minus the item margin.  -->
                                <ColumnDefinition Width="{Binding CompactPaneLength, RelativeSource={RelativeSource AncestorType={x:Type navigation:NavigationView}}, Converter={x:Static navigation:NavigationViewIconColumnWidthValueConverter.Instance}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="PART_SelectionIndicator"
                                Grid.Column="0"
                                Width="3"
                                Height="16"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AtcApps.Brushes.Accent}"
                                CornerRadius="1.5"
                                Visibility="Collapsed" />
                            <ContentPresenter
                                x:Name="PART_Icon"
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}" />
                            <ContentPresenter
                                x:Name="PART_Content"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource AtcApps.Brushes.Gray9}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource AtcApps.Brushes.Accent4}" />
                            <Setter TargetName="PART_SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="Background" Value="{DynamicResource AtcApps.Brushes.Gray8}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  NavigationView style  -->
    <Style x:Key="AtcApps.Styles.NavigationView" TargetType="{x:Type navigation:NavigationView}">
        <Setter Property="Background" Value="{DynamicResource AtcApps.Brushes.ThemeBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AtcApps.Brushes.Gray8}" />
        <Setter Property="Foreground" Value="{DynamicResource AtcApps.Brushes.Text}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="PaneBackground" Value="{DynamicResource AtcApps.Brushes.Gray10}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type navigation:NavigationView}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Pane  -->
                        <Border
                            x:Name="PART_Pane"
                            Grid.Column="0"
                            Width="{TemplateBinding OpenPaneLength}"
                            Background="{TemplateBinding PaneBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,1,0"
                            ClipToBounds="True">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                                    <Button
                                        x:Name="PART_BackButton"
                                        Margin="4,4,4,0"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Back"
                                        IsEnabled="{TemplateBinding IsBackEnabled}"
                                        Style="{StaticResource AtcApps.Styles.NavigationView.PaneButton}"
                                        ToolTip="Back">
                                        <Button.Width>
                                            <Binding
                                                Converter="{x:Static navigation:NavigationViewIconColumnWidthValueConverter.Instance}"
                                                Path="CompactPaneLength"
                                                RelativeSource="{RelativeSource TemplatedParent}" />
                                        </Button.Width>
                                        <Path
                                            Data="{StaticResource AtcApps.Geometries.NavigationView.Back}"
                                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.5" />
                                    </Button>
                                    <DockPanel Margin="4,4,4,4" LastChildFill="True">
                                        <ToggleButton
                                            x:Name="PART_PaneToggleButton"
                                            AutomationProperties.Name="Toggle navigation pane"
                                            DockPanel.Dock="Left"
                                            IsChecked="{Binding IsPaneOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                            Style="{StaticResource AtcApps.Styles.NavigationView.PaneButton}"
                                            ToolTip="Navigation">
                                            <ToggleButton.Width>
                                                <Binding
                                                    Converter="{x:Static navigation:NavigationViewIconColumnWidthValueConverter.Instance}"
                                                    Path="CompactPaneLength"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                            </ToggleButton.Width>
                                            <Path
                                                Data="{StaticResource AtcApps.Geometries.NavigationView.Hamburger}"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </ToggleButton>
                                        <ContentPresenter
                                            x:Name="PART_PaneTitle"
                                            Margin="4,0,8,0"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding PaneTitle}"
                                            TextElement.FontSize="16"
                                            TextElement.FontWeight="SemiBold" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel
                                    x:Name="PART_FooterMenuItemsHost"
                                    Margin="0,4,0,4"
                                    DockPanel.Dock="Bottom"
                                    Orientation="Vertical" />
                                <ScrollViewer
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PART_MenuItemsHost" Orientation="Vertical" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!--  Content  -->
                        <ContentPresenter
                            x:Name="PART_Content"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPaneOpen" Value="False">
                            <Setter TargetName="PART_Pane" Property="Width" Value="{Binding CompactPaneLength, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_PaneTitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsBackButtonVisible" Value="False">
                            <Setter TargetName="PART_BackButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>