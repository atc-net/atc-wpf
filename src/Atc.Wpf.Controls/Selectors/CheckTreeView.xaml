<UserControl
    x:Class="Atc.Wpf.Controls.Selectors.CheckTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:Atc.Wpf.Controls.Selectors"
    MinWidth="120"
    d:DesignHeight="300"
    d:DesignWidth="250"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  A node row: check box, optional icon, the text (the consumer's ItemTemplate or the node text) and, for a flat filter result, its path.  -->
        <DataTemplate x:Key="CheckTreeRowTemplate" DataType="{x:Type selectors:CheckTreeNode}">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <selectors:CheckTreeCheckBox
                    x:Name="Check"
                    Grid.Column="0"
                    MinWidth="0"
                    Margin="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=IsChecked, Mode=OneWay}" />
                <ContentPresenter
                    x:Name="Icon"
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Content="{Binding Path=Icon}" />
                <StackPanel
                    x:Name="TextPanel"
                    Grid.Column="2"
                    Margin="6,1,4,1"
                    VerticalAlignment="Center">
                    <ContentPresenter
                        x:Name="Text"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType={x:Type selectors:CheckTreeView}}, Path=ItemTemplate}">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    <TextBlock
                        x:Name="Path"
                        FontSize="11"
                        Foreground="{DynamicResource AtcApps.Brushes.Gray}"
                        Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=Tag}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Path=Icon}" Value="{x:Null}">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=Tag}" Value="{x:Null}">
                    <Setter TargetName="Path" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=IsEnabled}" Value="False">
                    <Setter TargetName="Check" Property="IsEnabled" Value="False" />
                    <Setter TargetName="TextPanel" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=IsChecked}" Value="False" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type selectors:CheckTreeView}}, Path=IsAtSelectionLimit}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Check" Property="IsEnabled" Value="False" />
                    <Setter TargetName="TextPanel" Property="Opacity" Value="0.55" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  The row shown under a node while its children load.  -->
        <DataTemplate x:Key="CheckTreeBusyRowTemplate" DataType="{x:Type selectors:CheckTreeNode}">
            <TextBlock
                Margin="4,1"
                VerticalAlignment="Center"
                FontStyle="Italic"
                Foreground="{DynamicResource AtcApps.Brushes.Gray}"
                Text="{Binding Path=Text}" />
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel
            x:Name="PartSelectAllRow"
            Grid.Row="0"
            Margin="5,4,5,4"
            Visibility="Collapsed">
            <Button
                x:Name="PartClear"
                Margin="8,0,0,0"
                Padding="8,1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Clear"
                Click="OnClearClick"
                DockPanel.Dock="Right" />
            <TextBlock
                x:Name="PartCount"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SelectionCount"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource AtcApps.Brushes.Gray}" />
            <CheckBox
                x:Name="PartSelectAll"
                Padding="6,0,0,0"
                VerticalContentAlignment="Center"
                AutomationProperties.AutomationId="SelectAll"
                Checked="OnSelectAllIsCheckedChanged"
                Focusable="True"
                Indeterminate="OnSelectAllIsCheckedChanged"
                IsChecked="False"
                Unchecked="OnSelectAllIsCheckedChanged" />
        </DockPanel>

        <TextBox
            x:Name="PartFilter"
            Grid.Row="1"
            Margin="4,0,4,4"
            atc:TextBoxHelper.ClearTextButton="True"
            AutomationProperties.AutomationId="Filter"
            PreviewKeyDown="OnFilterPreviewKeyDown"
            Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type selectors:CheckTreeView}}, Path=FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="Collapsed" />

        <Border x:Name="PartTreeHost" Grid.Row="2" />

        <TextBlock
            x:Name="PartNoMatches"
            Grid.Row="2"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Foreground="{DynamicResource AtcApps.Brushes.Gray}"
            Visibility="Collapsed" />
    </Grid>

</UserControl>