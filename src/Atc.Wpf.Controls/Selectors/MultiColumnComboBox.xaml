<UserControl
    x:Class="Atc.Wpf.Controls.Selectors.MultiColumnComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:decorators="clr-namespace:Atc.Wpf.Theming.Decorators;assembly=Atc.Wpf.Theming"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="clr-namespace:Atc.Wpf.Controls.Selectors"
    MinHeight="26"
    Padding="4"
    VerticalContentAlignment="Center"
    atc:ControlsHelper.CornerRadius="{DynamicResource AtcApps.CornerRadius.ComboBox}"
    atc:ControlsHelper.FocusBorderBrush="{DynamicResource AtcApps.Brushes.ComboBox.Border.Focus}"
    atc:ControlsHelper.MouseOverBorderBrush="{DynamicResource AtcApps.Brushes.ComboBox.Border.MouseOver}"
    atc:TextBoxHelper.ButtonWidth="22"
    Background="{DynamicResource AtcApps.Brushes.Control.Background}"
    BorderBrush="{DynamicResource AtcApps.Brushes.TextBox.Border}"
    BorderThickness="1"
    Focusable="True"
    FontFamily="{DynamicResource AtcApps.Fonts.Family.Control}"
    FontSize="{DynamicResource AtcApps.Font.Size.Content}"
    Foreground="{DynamicResource AtcApps.Brushes.Text}"
    IsTabStop="True"
    SnapsToDevicePixels="True"
    d:DesignHeight="26"
    d:DesignWidth="220"
    mc:Ignorable="d">

    <UserControl.Template>
        <ControlTemplate TargetType="{x:Type selectors:MultiColumnComboBox}">
            <Grid x:Name="PartRoot">
                <Border
                    x:Name="PartBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding atc:ControlsHelper.CornerRadius}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <ContentPresenter Margin="{TemplateBinding BorderThickness}" />
                <Border
                    x:Name="DisabledVisualElement"
                    Background="{DynamicResource AtcApps.Brushes.Control.Disabled}"
                    BorderBrush="{DynamicResource AtcApps.Brushes.Control.Disabled}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding atc:ControlsHelper.CornerRadius}"
                    IsHitTestVisible="False"
                    Opacity="0"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="PartBorder" Property="Background" Value="{DynamicResource AtcApps.Brushes.ThemeBackground1}" />
                    <Setter TargetName="PartBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:ControlsHelper.MouseOverBorderBrush)}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="PartBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:ControlsHelper.FocusBorderBrush)}" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="PartBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(atc:ControlsHelper.FocusBorderBrush)}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="DisabledVisualElement" Property="Opacity" Value="0.6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>

    <!--  Bindings to the control itself are set in code (Source = this), so they work before the control is loaded.  -->
    <Grid x:Name="PartContentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PartToggleColumn" Width="22" />
        </Grid.ColumnDefinitions>

        <!--  The arrow; the whole box is the click target that opens and closes the pop-up.  -->
        <ToggleButton
            x:Name="PartDropDownToggle"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="Transparent"
            BorderThickness="0"
            Focusable="False"
            IsTabStop="False"
            Style="{DynamicResource AtcApps.Styles.ToggleButton.ComboBoxDropDown}" />

        <!--  The closed-box summary. Code fills it with a TextBlock; any content can replace it.  -->
        <ContentPresenter
            x:Name="PartSummaryHost"
            Grid.Column="0"
            Margin="1,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            IsHitTestVisible="False" />

        <TextBlock
            x:Name="PartWatermark"
            Grid.Column="0"
            Margin="4,0"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Style="{DynamicResource AtcApps.Styles.TextBlock.Watermark}"
            TextTrimming="CharacterEllipsis" />

        <Popup
            x:Name="PartPopup"
            AllowsTransparency="True"
            Focusable="False"
            Placement="Bottom"
            PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
            <decorators:ClipBorder
                x:Name="PartPopupBorder"
                Background="{DynamicResource AtcApps.Brushes.ThemeBackground}"
                BorderBrush="{DynamicResource AtcApps.Brushes.ComboBox.PopupBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
                <DockPanel>
                    <!--  The filter box; shown by IsFilterVisible (auto: above 10 items).  -->
                    <TextBox
                        x:Name="PartFilter"
                        Margin="4,4,4,4"
                        atc:TextBoxHelper.ClearTextButton="True"
                        AutomationProperties.AutomationId="Filter"
                        DockPanel.Dock="Top"
                        PreviewKeyDown="OnFilterPreviewKeyDown"
                        Visibility="Collapsed" />

                    <!--  "{0} of {1} selected" and, when CommitMode is Deferred, OK / Cancel.  -->
                    <Border
                        x:Name="PartFooter"
                        Padding="6,4"
                        BorderBrush="{DynamicResource AtcApps.Brushes.ComboBox.PopupBorder}"
                        BorderThickness="0,1,0,0"
                        DockPanel.Dock="Bottom">
                        <DockPanel>
                            <StackPanel
                                x:Name="PartCommitFooter"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="PartOkButton"
                                    MinWidth="64"
                                    Margin="8,0,0,0"
                                    Padding="8,1"
                                    AutomationProperties.AutomationId="Ok"
                                    Click="OnOkClick" />
                                <Button
                                    x:Name="PartCancelButton"
                                    MinWidth="64"
                                    Margin="6,0,0,0"
                                    Padding="8,1"
                                    AutomationProperties.AutomationId="Cancel"
                                    Click="OnCancelClick" />
                            </StackPanel>
                            <TextBlock
                                x:Name="PartFooterText"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="SelectionCount"
                                Foreground="{DynamicResource AtcApps.Brushes.Gray}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <!--  Columns, row and cell styles are set in code (the caller's columns follow the check column).  -->
                        <DataGrid
                            x:Name="PartGrid"
                            AutoGenerateColumns="False"
                            AutomationProperties.AutomationId="Items"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeColumns="True"
                            CanUserResizeRows="False"
                            CanUserSortColumns="True"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling" />
                        <TextBlock
                            x:Name="PartNoMatches"
                            Margin="8,32,8,8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource AtcApps.Brushes.Gray}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </decorators:ClipBorder>
        </Popup>
    </Grid>

</UserControl>