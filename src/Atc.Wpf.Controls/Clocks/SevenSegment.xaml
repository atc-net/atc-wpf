<UserControl
    x:Class="Atc.Wpf.Controls.Clocks.SevenSegment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="100"
    d:DesignWidth="60"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SegmentPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Fill" Value="{Binding ElementName=Root, Path=NumberColor}" />
        </Style>

        <Style x:Key="ColonRectangleStyle" TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Fill" Value="{Binding ElementName=Root, Path=ColonColor}" />
            <Setter Property="Visibility" Value="{Binding ElementName=Root, Path=ShowColon, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
        </Style>

        <Style x:Key="DotRectangleStyle" TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0,0,-100,20" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Fill" Value="{Binding ElementName=Root, Path=ColonColor}" />
            <Setter Property="Visibility" Value="{Binding ElementName=Root, Path=ShowDot, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
        </Style>
    </UserControl.Resources>

    <Viewbox>
        <Grid Width="600" Height="1000">
            <Grid x:Name="OriginGrid">
                <Path
                    x:Name="MiddlePath"
                    Margin="100,440"
                    Data="M80,520 L140,460 420,460 480,520 420,580 140,580 z"
                    Style="{StaticResource SegmentPathStyle}" />
                <Path
                    x:Name="TopLeftPath"
                    Width="100"
                    Height="400"
                    Margin="40,80,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    Style="{StaticResource SegmentPathStyle}" />
                <Path
                    x:Name="TopPath"
                    Height="400"
                    Margin="250,-130,250,0"
                    VerticalAlignment="Top"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="90" />
                    </Path.RenderTransform>
                </Path>
                <Path
                    x:Name="TopRightPath"
                    Width="100"
                    Height="400"
                    Margin="0,80,40,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="180" />
                    </Path.RenderTransform>
                </Path>
                <Path
                    x:Name="BottomLeftPath"
                    Width="100"
                    Height="400"
                    Margin="40,0,0,80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    Style="{StaticResource SegmentPathStyle}" />
                <Path
                    x:Name="BottomRightPath"
                    Width="100"
                    Height="400"
                    Margin="0,0,40,80"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="180" />
                    </Path.RenderTransform>
                </Path>
                <Path
                    x:Name="BottomPath"
                    Height="400"
                    Margin="250,0,250,-130"
                    VerticalAlignment="Bottom"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="270" />
                    </Path.RenderTransform>
                </Path>
                <Rectangle
                    x:Name="Colon1Rectangle"
                    Margin="0,360,-100,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource ColonRectangleStyle}" />
                <Rectangle
                    x:Name="Colon2Rectangle"
                    Margin="0,0,-100,360"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ColonRectangleStyle}" />
                <Rectangle x:Name="DotRectangle" Style="{StaticResource DotRectangleStyle}" />
            </Grid>

            <Grid x:Name="EffectGrid">
                <Grid.Effect>
                    <BlurEffect Radius="{Binding ElementName=Root, Path=BlurRadius}" />
                </Grid.Effect>
                <Path
                    x:Name="MiddleBlurPath"
                    Margin="100,440"
                    Data="M80,520 L140,460 420,460 480,520 420,580 140,580 z"
                    Style="{StaticResource SegmentPathStyle}" />
                <Path
                    x:Name="TopLeftBlurPath"
                    Width="100"
                    Height="400"
                    Margin="40,80,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    Style="{StaticResource SegmentPathStyle}" />
                <Path
                    x:Name="TopBlurPath"
                    Height="400"
                    Margin="250,-130,250,0"
                    VerticalAlignment="Top"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="90" />
                    </Path.RenderTransform>
                </Path>
                <Path
                    x:Name="TopRightBlurPath"
                    Width="100"
                    Height="400"
                    Margin="0,80,40,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="180" />
                    </Path.RenderTransform>
                </Path>
                <Path
                    x:Name="BottomLeftBlurPath"
                    Width="100"
                    Height="400"
                    Margin="40,0,0,80"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    Style="{StaticResource SegmentPathStyle}" />
                <Path
                    x:Name="BottomRightBlurPath"
                    Width="100"
                    Height="400"
                    Margin="0,0,40,80"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="180" />
                    </Path.RenderTransform>
                </Path>
                <Path
                    x:Name="BottomBlurPath"
                    Height="400"
                    Margin="250,0,250,-130"
                    VerticalAlignment="Bottom"
                    Data="M140,440 L80,500 40,460 40,140 80,100 140,160 z"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource SegmentPathStyle}">
                    <Path.RenderTransform>
                        <RotateTransform Angle="270" />
                    </Path.RenderTransform>
                </Path>
                <Rectangle
                    x:Name="Colon1BlurRectangle"
                    Margin="0,360,-100,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource ColonRectangleStyle}" />
                <Rectangle
                    x:Name="Colon2BlurRectangle"
                    Margin="0,0,-100,360"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ColonRectangleStyle}" />
                <Rectangle x:Name="DotBlurRectangle" Style="{StaticResource DotRectangleStyle}" />
            </Grid>
        </Grid>
    </Viewbox>

</UserControl>