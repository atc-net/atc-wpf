<UserControl
    x:Class="Atc.Wpf.Network.Scanner.NetworkScannerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcForms="clr-namespace:Atc.Wpf.Forms;assembly=Atc.Wpf.Forms"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:network="clr-namespace:Atc.Wpf.Network.Scanner"
    d:DataContext="{d:DesignInstance Type=network:NetworkScannerViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="120"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="20">
        <StackPanel Orientation="Vertical">
            <atcForms:LabelComboBox
                Items="{Binding Path=LocalNetworkItems}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=LocalNetwork}"
                LabelWidthNumber="40"
                LabelWidthSizeDefinition="Percentage"
                SelectedKey="{Binding Path=SelectedLocalNetworkKey, Mode=TwoWay}" />
            <atcForms:LabelIPRangeBox
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=RangeCidr}"
                LabelWidthNumber="40"
                LabelWidthSizeDefinition="Percentage"
                Text="{Binding Path=RangeCidr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                WatermarkText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=RangeCidrExample}" />
            <atcForms:LabelIPAddressBox
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=StartIp}"
                LabelWidthNumber="40"
                LabelWidthSizeDefinition="Percentage"
                Text="{Binding Path=StartIpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                              Key=StartIpToolTip}"
                WatermarkText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=StartIpExample}" />
            <atcForms:LabelIPAddressBox
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=EndIp}"
                LabelWidthNumber="40"
                LabelWidthSizeDefinition="Percentage"
                Text="{Binding Path=EndIpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ValidationFormat="IPv4Address"
                WatermarkText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=EndIpExample}" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <atcForms:LabelComboBox
                Items="{Binding Path=PortPresetItems}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=PortPreset}"
                LabelWidthNumber="40"
                LabelWidthSizeDefinition="Percentage"
                SelectedKey="{Binding Path=SelectedPortPresetKey, Mode=TwoWay}" />
            <atcForms:LabelTextBox
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=Ports}"
                LabelWidthNumber="40"
                LabelWidthSizeDefinition="Percentage"
                Text="{Binding Path=PortsNumbersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                WatermarkText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=PortsExample}" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.IcmpPing, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionIcmpPing}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.ResolveHostName, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionResolveHostName}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel"
                ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                              Key=OptionResolveHostNameToolTip}" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.ResolveNetBiosName, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionResolveNetBiosName}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.ResolveMacAddress, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionResolveMacAddress}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.ResolveVendorFromMacAddress, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionResolveVendorFromMacAddress}"
                LabelWidthNumber="170"
                LabelWidthSizeDefinition="Pixel"
                ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                              Key=OptionResolveVendorFromMacAddressToolTip}" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.DiscoverServices, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionDiscoverServices}"
                LabelWidthNumber="170"
                LabelWidthSizeDefinition="Pixel" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Options.DiscoverOnvif, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=OptionDiscoverOnvif}"
                LabelWidthNumber="170"
                LabelWidthSizeDefinition="Pixel" />
            <Expander Margin="0,4,0,0" Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=TimeoutsInMs}">
                <StackPanel Orientation="Vertical">
                    <atcForms:LabelIntegerBox
                        HideAreas="All"
                        LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                        Key=TimeoutPing}"
                        LabelWidthNumber="110"
                        LabelWidthSizeDefinition="Pixel"
                        Maximum="60000"
                        Minimum="50"
                        Value="{Binding Path=Options.TimeoutPingInMs, Mode=TwoWay}" />
                    <atcForms:LabelIntegerBox
                        HideAreas="All"
                        LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                        Key=TimeoutTcp}"
                        LabelWidthNumber="110"
                        LabelWidthSizeDefinition="Pixel"
                        Maximum="60000"
                        Minimum="50"
                        Value="{Binding Path=Options.TimeoutTcpInMs, Mode=TwoWay}" />
                    <atcForms:LabelIntegerBox
                        HideAreas="All"
                        LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                        Key=TimeoutHttp}"
                        LabelWidthNumber="110"
                        LabelWidthSizeDefinition="Pixel"
                        Maximum="60000"
                        Minimum="50"
                        Value="{Binding Path=Options.TimeoutHttpInMs, Mode=TwoWay}" />
                    <atcForms:LabelIntegerBox
                        HideAreas="All"
                        LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                        Key=TimeoutDiscovery}"
                        LabelWidthNumber="110"
                        LabelWidthSizeDefinition="Pixel"
                        Maximum="60000"
                        Minimum="50"
                        Value="{Binding Path=Options.TimeoutDiscoveryInMs, Mode=TwoWay}" />
                    <atcForms:LabelIntegerBox
                        HideAreas="All"
                        LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                        Key=TimeoutNetBios}"
                        LabelWidthNumber="110"
                        LabelWidthSizeDefinition="Pixel"
                        Maximum="60000"
                        Minimum="50"
                        Value="{Binding Path=Options.TimeoutNetBiosInMs, Mode=TwoWay}" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Filter.ShowOnlySuccess, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=ShowOnlySuccess}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Filter.ShowOnlyWithOpenPorts, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=ShowOnlyWithOpenPorts}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel" />
            <atcForms:LabelCheckBox
                HideAreas="All"
                IsChecked="{Binding Path=Filter.ShowOnlyReachable, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=ShowOnlyReachable}"
                LabelWidthNumber="150"
                LabelWidthSizeDefinition="Pixel" />
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                <Button
                    Width="100"
                    Command="{Binding Path=ScanCommand}"
                    Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                  Key=Scan}" />
                <Button
                    Width="100"
                    Command="{Binding Path=ClearCommand}"
                    Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                  Key=Clear}" />
            </atc:UniformSpacingPanel>
            <atc:UniformSpacingPanel
                Margin="0,10,0,0"
                Orientation="Horizontal"
                Spacing="10">
                <atcForms:LabelTextInfo
                    HideAreas="All"
                    LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                    Key=Entries}"
                    Text="{Binding Path=EntryCountInfo}" />
            </atc:UniformSpacingPanel>
            <atc:UniformSpacingPanel
                Margin="0,10,0,0"
                Orientation="Horizontal"
                Spacing="10">
                <atcForms:LabelTextInfo
                    HideAreas="All"
                    LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                    Key=Time}"
                    Text="{Binding Path=CompletionTime}" />
            </atc:UniformSpacingPanel>
        </StackPanel>
    </atc:UniformSpacingPanel>

</UserControl>