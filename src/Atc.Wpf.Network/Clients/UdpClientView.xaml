<UserControl
    x:Class="Atc.Wpf.Network.Clients.UdpClientView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcForms="clr-namespace:Atc.Wpf.Forms;assembly=Atc.Wpf.Forms"
    xmlns:atcNetwork="clr-namespace:Atc.Network;assembly=Atc.Network"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:clients="clr-namespace:Atc.Wpf.Network.Clients"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewers="clr-namespace:Atc.Wpf.Components.Viewers;assembly=Atc.Wpf.Components"
    d:DataContext="{d:DesignInstance Type=clients:UdpClientViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="TerminationTypes"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="atcNetwork:TerminationType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider
            x:Key="MessageFramings"
            MethodName="GetValues"
            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="atcNetwork:TcpMessageFraming" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <DockPanel>
        <atc:UniformSpacingPanel
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            ItemVerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="14">
            <atcForms:LabelIPAddressBox
                MinWidth="220"
                HideAreas="AsteriskAndInformation"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=ClientHost}"
                Orientation="Vertical"
                Text="{Binding Path=Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ValidationFormat="IPAddressOrHostname"
                WatermarkText="192.168.1.10" />
            <atcForms:LabelIntegerBox
                Width="220"
                HideAreas="AsteriskAndInformation"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncPort}"
                Maximum="65535"
                Minimum="1"
                Orientation="Vertical"
                Value="{Binding Path=Port, Mode=TwoWay}" />
            <Button
                Width="100"
                VerticalAlignment="Bottom"
                Command="{Binding Path=ConnectCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncConnect}" />
            <Button
                Width="100"
                VerticalAlignment="Bottom"
                Command="{Binding Path=DisconnectCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncDisconnect}" />
        </atc:UniformSpacingPanel>

        <TextBlock
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Foreground="{DynamicResource AtcApps.Brushes.Control.Validation}"
            Text="{Binding Path=ErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding Path=HasError, Converter={x:Static atcValueConverters:BoolToVisibilityCollapsedValueConverter.Instance}}" />

        <DockPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <Button
                Width="100"
                Margin="10,0,0,0"
                Command="{Binding Path=SendCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=ClientSend}"
                DockPanel.Dock="Right"
                IsDefault="True" />
            <ComboBox
                Width="190"
                Margin="10,0,0,0"
                DockPanel.Dock="Right"
                ItemsSource="{Binding Source={StaticResource TerminationTypes}}"
                SelectedItem="{Binding Path=LineEnding}"
                ToolTip="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=ClientLineEnding}" />
            <CheckBox
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=ClientShowReceivedAsHex}"
                DockPanel.Dock="Right"
                IsChecked="{Binding Path=ShowReceivedAsHex}" />
            <CheckBox
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=ClientSendAsHex}"
                DockPanel.Dock="Right"
                IsChecked="{Binding Path=SendAsHex}" />
            <TextBox
                VerticalContentAlignment="Center"
                AutomationProperties.AutomationId="NetworkClientSendText"
                Text="{Binding Path=SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <viewers:TerminalViewer
            MinHeight="160"
            ShowClearInToolbar="True"
            ShowCopyInToolbar="True"
            TerminalId="{Binding Path=TerminalId}"
            TermsError="{Binding Path=ErrorTerms}" />
    </DockPanel>

</UserControl>