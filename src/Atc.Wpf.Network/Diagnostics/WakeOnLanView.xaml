<UserControl
    x:Class="Atc.Wpf.Network.Diagnostics.WakeOnLanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcForms="clr-namespace:Atc.Wpf.Forms;assembly=Atc.Wpf.Forms"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diagnostics="clr-namespace:Atc.Wpf.Network.Diagnostics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=diagnostics:WakeOnLanViewModel}"
    d:DesignHeight="150"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <UserControl.Resources>
        <atcValueConverters:BoolToVisibilityCollapsedValueConverter x:Key="BoolToVisibilityCollapsedValueConverter" />
    </UserControl.Resources>

    <StackPanel>
        <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="20">
            <atcForms:LabelMacAddressBox
                MinWidth="200"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=MacAddress}"
                Text="{Binding Path=MacAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                WatermarkText="00-11-22-33-44-55" />
            <atcForms:LabelIPAddressBox
                MinWidth="160"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=WakeOnLanBroadcastAddress}"
                Text="{Binding Path=BroadcastAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <atcForms:LabelIntegerBox
                Width="120"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncPort}"
                Maximum="65535"
                Minimum="1"
                Value="{Binding Path=Port, Mode=TwoWay}" />
            <Button
                Width="140"
                VerticalAlignment="Bottom"
                Command="{Binding Path=SendCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=WakeOnLanSend}" />
        </atc:UniformSpacingPanel>
        <TextBlock Margin="0,6,0,0" Text="{Binding Path=StatusMessage}" />
            <TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource AtcApps.Brushes.Control.Validation}"
                Text="{Binding Path=ErrorMessage}"
                TextWrapping="Wrap"
                Visibility="{Binding Path=HasError, Converter={StaticResource BoolToVisibilityCollapsedValueConverter}}" />
    </StackPanel>

</UserControl>