<UserControl
    x:Class="Atc.Wpf.Network.Diagnostics.TracerouteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcForms="clr-namespace:Atc.Wpf.Forms;assembly=Atc.Wpf.Forms"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diagnostics="clr-namespace:Atc.Wpf.Network.Diagnostics"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=diagnostics:TracerouteViewModel}"
    d:DesignHeight="400"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <UserControl.Resources>
        <atcValueConverters:BoolToVisibilityCollapsedValueConverter x:Key="BoolToVisibilityCollapsedValueConverter" />
    </UserControl.Resources>

    <atc:GridEx Rows="Auto,Auto,*">
        <atc:UniformSpacingPanel
            Grid.Row="0"
            ItemVerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="20">
            <atcForms:LabelIPAddressBox
                MinWidth="260"
                HideAreas="AsteriskAndInformation"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=TracerouteTarget}"
                Orientation="Vertical"
                Text="{Binding Path=Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ValidationFormat="IPAddressOrHostname"
                WatermarkText="1.1.1.1" />
            <atcForms:LabelIntegerBox
                Width="220"
                HideAreas="AsteriskAndInformation"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=TracerouteMaxHops}"
                Maximum="255"
                Minimum="1"
                Orientation="Vertical"
                Value="{Binding Path=MaxHops, Mode=TwoWay}" />
            <atcForms:LabelIntegerBox
                Width="220"
                HideAreas="AsteriskAndInformation"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                Key=TracerouteTimeoutPerHop}"
                Maximum="10000"
                Minimum="100"
                Orientation="Vertical"
                Value="{Binding Path=TimeoutPerHopInMs, Mode=TwoWay}" />
            <atcForms:LabelCheckBox
                Width="120"
                HideAreas="AsteriskAndInformation"
                IsChecked="{Binding Path=ResolveHostNames, Mode=TwoWay}"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=TracerouteResolveHostNames}"
                Orientation="Vertical" />
            <Button
                Width="100"
                VerticalAlignment="Bottom"
                Command="{Binding Path=TraceCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                              Key=TracerouteStart}" />
            <Button
                Width="100"
                VerticalAlignment="Bottom"
                Command="{Binding Path=TraceCancelCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                              Key=Cancel}" />
        </atc:UniformSpacingPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,6,0,0"
            Foreground="{DynamicResource AtcApps.Brushes.Control.Validation}"
            Text="{Binding Path=ErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding Path=HasError, Converter={StaticResource BoolToVisibilityCollapsedValueConverter}}" />

        <ListView
            Grid.Row="2"
            Margin="0,10,0,0"
            AutomationProperties.AutomationId="TracerouteHopsList"
            ItemsSource="{Binding Path=Hops}">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="50"
                        DisplayMemberBinding="{Binding Path=HopNumber}"
                        Header="#" />
                    <GridViewColumn
                        Width="150"
                        DisplayMemberBinding="{Binding Path=IpAddress, TargetNullValue='*'}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                     Key=IpAddress}" />
                    <GridViewColumn
                        Width="90"
                        DisplayMemberBinding="{Binding Path=RoundtripTimeText}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                     Key=Time}" />
                    <GridViewColumn
                        Width="260"
                        DisplayMemberBinding="{Binding Path=HostName}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                     Key=Hostname}" />
                    <GridViewColumn
                        Width="120"
                        DisplayMemberBinding="{Binding Path=Status}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                                     Key=IpStatus}" />
                </GridView>
            </ListView.View>
        </ListView>
    </atc:GridEx>

</UserControl>