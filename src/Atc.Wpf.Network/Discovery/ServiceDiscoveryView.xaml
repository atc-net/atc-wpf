<UserControl
    x:Class="Atc.Wpf.Network.Discovery.ServiceDiscoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcForms="clr-namespace:Atc.Wpf.Forms;assembly=Atc.Wpf.Forms"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:discovery="clr-namespace:Atc.Wpf.Network.Discovery"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scanner="clr-namespace:Atc.Wpf.Network.Scanner"
    d:DataContext="{d:DesignInstance Type=discovery:ServiceDiscoveryViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <atcValueConverters:BoolToVisibilityCollapsedValueConverter x:Key="BoolToVisibilityCollapsedValueConverter" />
    </UserControl.Resources>

    <atc:GridEx Columns="2*,10,*" Rows="Auto,Auto,*">
        <atc:UniformSpacingPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            ItemVerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="20">
            <atcForms:LabelCheckBox
                Width="60"
                HideAreas="AsteriskAndInformation"
                IsChecked="{Binding Path=UseMdns, Mode=TwoWay}"
                LabelText="mDNS"
                Orientation="Vertical" />
            <atcForms:LabelCheckBox
                Width="90"
                HideAreas="AsteriskAndInformation"
                IsChecked="{Binding Path=UseSsdp, Mode=TwoWay}"
                LabelText="SSDP (UPnP)"
                Orientation="Vertical" />
            <atcForms:LabelCheckBox
                Width="60"
                HideAreas="AsteriskAndInformation"
                IsChecked="{Binding Path=UseOnvif, Mode=TwoWay}"
                LabelText="ONVIF"
                Orientation="Vertical" />
            <atcForms:LabelIntegerBox
                Width="220"
                HideAreas="AsteriskAndInformation"
                LabelText="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=DiscoveryDuration}"
                Maximum="30000"
                Minimum="500"
                Orientation="Vertical"
                Value="{Binding Path=DurationInMs, Mode=TwoWay}" />
            <Button
                Width="100"
                Command="{Binding Path=DiscoverCommand}"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=Discover}" />
            <ProgressBar
                Width="80"
                Height="6"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding Path=IsBusy, Converter={StaticResource BoolToVisibilityCollapsedValueConverter}}" />
            <TextBlock VerticalAlignment="Center">
                <Run Text="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=Devices}" /><Run Text=": " /><Run Text="{Binding Path=Devices.Count, Mode=OneWay}" />
            </TextBlock>
        </atc:UniformSpacingPanel>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,6,0,0"
            Foreground="{DynamicResource AtcApps.Brushes.Control.Validation}"
            Text="{Binding Path=ErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding Path=HasError, Converter={StaticResource BoolToVisibilityCollapsedValueConverter}}" />

        <ListView
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,10,0,0"
            AutomationProperties.AutomationId="ServiceDiscoveryDevicesList"
            ItemsSource="{Binding Path=Devices}"
            SelectedItem="{Binding Path=SelectedDevice, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="120"
                        DisplayMemberBinding="{Binding Path=IpAddress}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=IpAddress}" />
                    <GridViewColumn
                        Width="180"
                        DisplayMemberBinding="{Binding Path=DeviceName}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=DeviceName}" />
                    <GridViewColumn
                        Width="220"
                        DisplayMemberBinding="{Binding Path=Model}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=Model}" />
                    <GridViewColumn
                        Width="200"
                        DisplayMemberBinding="{Binding Path=ServicesAsCommaList}"
                        Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=Services}" />
                    <GridViewColumn Width="80" Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=Onvif}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type scanner:NetworkHostViewModel}">
                                <TextBlock ToolTip="{Binding Path=OnvifDeviceServiceUrl}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=IsOnvifDevice}" Value="True">
                                                    <Setter Property="Text" Value="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=OnvifDevice}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=IsOnvifCamera}" Value="True">
                                                    <Setter Property="Text" Value="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=OnvifCamera}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <scanner:NetworkHostDetailsView
            Grid.Row="2"
            Grid.Column="2"
            Margin="0,10,0,0"
            DataContext="{Binding Path=SelectedDevice}" />
    </atc:GridEx>

</UserControl>