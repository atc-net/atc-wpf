<UserControl
    x:Class="Atc.Wpf.Network.Vnc.VncViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Network.Vnc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:VncViewerViewModel}"
    d:DesignHeight="480"
    d:DesignWidth="640"
    Focusable="True"
    mc:Ignorable="d">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Command="{Binding Path=ConnectCommand}" Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncConnect}" />
            <MenuItem Command="{Binding Path=DisconnectCommand}" Header="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncDisconnect}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <DockPanel>
        <atc:UniformSpacingPanel
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Spacing="14">
            <TextBlock VerticalAlignment="Center" Text="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncScale}" />
            <ComboBox
                MinWidth="110"
                AutomationProperties.AutomationId="VncScaleMode"
                SelectedValue="{Binding Path=ScaleMode, Mode=TwoWay}"
                SelectedValuePath="Tag">
                <ComboBoxItem Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncScaleFit}" Tag="{x:Static local:VncScaleMode.Fit}" />
                <ComboBoxItem Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncScaleFill}" Tag="{x:Static local:VncScaleMode.Fill}" />
                <ComboBoxItem Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncScaleOriginal}" Tag="{x:Static local:VncScaleMode.Original}" />
            </ComboBox>
            <CheckBox
                VerticalAlignment="Center"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncViewOnly}"
                IsChecked="{Binding Path=ViewOnly}" />
            <CheckBox
                VerticalAlignment="Center"
                Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncShareClipboard}"
                IsChecked="{Binding Path=ShareClipboard}" />
            <Button Command="{Binding Path=SendClipboardCommand}" Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncSendClipboard}" />
            <Button Command="{Binding Path=RetryCommand}" Content="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources, Key=VncRetry}" />
        </atc:UniformSpacingPanel>

        <TextBlock
            Margin="0,0,0,6"
            DockPanel.Dock="Top"
            Foreground="{DynamicResource AtcApps.Brushes.Control.Validation}"
            Text="{Binding Path=ErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding Path=HasError, Converter={x:Static atcValueConverters:BoolToVisibilityCollapsedValueConverter.Instance}}" />

        <Grid Background="{DynamicResource AtcApps.Brushes.ThemeBackground}">

            <!--  Placeholder when not connected  -->
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground4}"
                Text="{atcTranslation:Resx ResxName=Atc.Wpf.Network.Resources.Resources,
                                           Key=VncNotConnected}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  VNC framebuffer; scrolls at 1:1 (Original), otherwise scaled into the view  -->
            <ScrollViewer Focusable="False">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsScrollable}" Value="True">
                                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Image
                    x:Name="VncImage"
                    Focusable="True"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Stretch="{Binding Path=Stretch}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </ScrollViewer>

            <!--  Loading overlay  -->
            <Border Background="#80000000" Visibility="{Binding Path=IsBusy, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <atc:LoadingIndicator
                        Width="60"
                        Height="60"
                        Foreground="{DynamicResource AtcApps.Brushes.Accent}"
                        IsActive="{Binding Path=IsBusy}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="{Binding Path=StatusMessage}" />
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>

</UserControl>