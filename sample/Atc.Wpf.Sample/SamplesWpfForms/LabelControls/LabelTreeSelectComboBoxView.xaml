<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfForms.LabelControls.LabelTreeSelectComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <atc:GridEx Columns="*,400">
        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <atc:LabelTreeSelectComboBox
                    x:Name="InteractiveLabelTreeSelectComboBox"
                    AutomationProperties.AutomationId="InteractiveLabelTreeSelectComboBox"
                    InformationText="{Binding InformationText}"
                    IsMandatory="{Binding IsMandatory}"
                    LabelText="{Binding LabelText}"
                    Orientation="{Binding Orientation}"
                    WatermarkText="Pick sales regions" />

                <TextBlock
                    x:Name="EventLog"
                    AutomationProperties.AutomationId="LabelTreeSelectComboBoxLog"
                    TextWrapping="Wrap" />

                <atc:GridEx Columns="*,*" ShowGridLines="True">
                    <StackPanel Grid.Column="0" Margin="10">

                        <atc:LabelTreeSelectComboBox
                            x:Name="RegionsBox"
                            LabelText="Regions"
                            WatermarkText="Any region" />

                        <atc:LabelTreeSelectComboBox
                            x:Name="MandatoryPermissionsBox"
                            CheckedKeysStrategy="Parents"
                            InformationText="Tick at least one permission."
                            IsMandatory="True"
                            LabelText="Permissions (mandatory)"
                            WatermarkText="Pick permissions" />

                        <atc:LabelTreeSelectComboBox
                            x:Name="ChipsBox"
                            CheckedKeysStrategy="Parents"
                            DisplayMode="Chips"
                            LabelText="Regions (chips, Parents)"
                            WatermarkText="Pick regions" />

                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10">

                        <atc:LabelTreeSelectComboBox
                            x:Name="VerticalBox"
                            LabelText="Regions"
                            Orientation="Vertical"
                            WatermarkText="Any region" />

                        <atc:LabelTreeSelectComboBox
                            x:Name="LimitBox"
                            AllText="Everywhere"
                            DisplayMode="Count"
                            InformationText="At most three sites."
                            IsMandatory="True"
                            LabelText="Sites (mandatory, at most 3)"
                            MaxSelectionCount="3"
                            NoneText="No sites"
                            Orientation="Vertical" />

                    </StackPanel>
                </atc:GridEx>

                <atc:GroupBoxExpander Header="A CheckTreeView inside LabelContent (no dedicated label wrapper is needed)">
                    <!--  The CheckTreeView is created in code-behind (a named element cannot be the content of LabelContent).  -->
                    <atc:LabelContent
                        x:Name="InlineTreeLabel"
                        Margin="10"
                        IsMandatory="True"
                        LabelText="Permissions" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>
        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>
</UserControl>