<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfForms.LabelControls.LabelTokenBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfForms.LabelControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <atc:GridEx Columns="*,400">
        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <atc:LabelTokenBox
                    x:Name="InteractiveLabelTokenBox"
                    AllowCreate="True"
                    AutomationProperties.AutomationId="InteractiveLabelTokenBox"
                    InformationText="{Binding InformationText}"
                    IsMandatory="{Binding IsMandatory}"
                    Items="{Binding Source={x:Static local:LabelTokenBoxView.KnownTags}}"
                    LabelText="{Binding LabelText}"
                    MaxSelectionCount="10"
                    Orientation="{Binding Orientation}"
                    WatermarkText="Add tags" />

                <TextBlock
                    x:Name="EventLog"
                    AutomationProperties.AutomationId="LabelTokenBoxLog"
                    TextWrapping="Wrap" />

                <atc:GridEx Columns="*,*" ShowGridLines="True">
                    <StackPanel Grid.Column="0" Margin="10">

                        <atc:LabelTokenBox
                            Items="{Binding Source={atc:EnumToKeyValueBindingSource {x:Type sys:DayOfWeek}, KeyAsString=True, IncludeDefault=True}}"
                            LabelText="Days"
                            WatermarkText="Type a day" />

                        <atc:LabelTokenBox
                            InformationText="Pick at least one day."
                            IsMandatory="True"
                            Items="{Binding Source={atc:EnumToKeyValueBindingSource {x:Type sys:DayOfWeek}, KeyAsString=True, IncludeDefault=True}}"
                            LabelText="Work days (mandatory)"
                            WatermarkText="Type a day" />

                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10">

                        <atc:LabelTokenBox
                            AllowCreate="True"
                            Items="{Binding Source={x:Static local:LabelTokenBoxView.KnownTags}}"
                            LabelText="Tags"
                            Orientation="Vertical"
                            ShowClearButton="True"
                            WatermarkText="Add tags" />

                        <atc:LabelTokenBox
                            InformationText="At most three."
                            IsMandatory="True"
                            Items="{Binding Source={atc:EnumToKeyValueBindingSource {x:Type sys:DayOfWeek}, KeyAsString=True, IncludeDefault=True}}"
                            LabelText="Meeting days (mandatory)"
                            MaxSelectionCount="3"
                            Orientation="Vertical"
                            TokensWrap="False"
                            WatermarkText="Type a day" />

                    </StackPanel>
                </atc:GridEx>

            </atc:UniformSpacingPanel>
        </ScrollViewer>
        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>
</UserControl>