<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfForms.LabelControls.LabelNetworkAddressBoxesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <atc:GridEx Columns="*">
        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <atc:LabelIPAddressBox
                    InformationText="An IPv4 or IPv6 address"
                    IsMandatory="True"
                    LabelText="IP address"
                    Orientation="Horizontal"
                    TriggerOnlyOnLostFocus="False"
                    WatermarkText="192.168.1.10" />

                <atc:LabelIPRangeBox
                    InformationText="An IPv4 range in CIDR notation"
                    LabelText="IP range"
                    Orientation="Horizontal"
                    TriggerOnlyOnLostFocus="False"
                    WatermarkText="192.168.1.0/24" />

                <atc:LabelMacAddressBox
                    InformationText="12 hexadecimal digits, separated by - : . or nothing"
                    LabelText="MAC address"
                    Orientation="Horizontal"
                    TriggerOnlyOnLostFocus="False"
                    WatermarkText="00-11-22-33-44-55" />

                <atc:LabelIPAddressBox
                    LabelText="IPv4 only"
                    Orientation="Horizontal"
                    TriggerOnlyOnLostFocus="False"
                    ValidationFormat="IPv4Address"
                    WatermarkText="10.0.0.1" />

            </atc:UniformSpacingPanel>
        </ScrollViewer>
    </atc:GridEx>
</UserControl>