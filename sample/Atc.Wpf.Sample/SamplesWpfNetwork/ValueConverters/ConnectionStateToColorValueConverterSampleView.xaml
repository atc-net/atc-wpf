<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfNetwork.ValueConverters.ConnectionStateToColorValueConverterSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfNetwork.ValueConverters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ConnectionStateToColorValueConverterSampleViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <atc:GridEx Columns="*" Rows="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Text="ConnectionStateToColorValueConverter" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource AtcApps.Brushes.Gray3}"
                Text="Each row is an editable palette entry. Click a ColorPicker to override that state's color — the override is written through ConnectionStateToColorValueConverter.SetColor(...) and both converters see it."
                TextWrapping="Wrap" />
        </StackPanel>

        <GroupBox
            Grid.Row="1"
            Padding="10"
            Header="Palette">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ConnectionStatePaletteEntry}">
                            <atc:GridEx
                                Margin="0,4"
                                Columns="180,80,200"
                                Rows="Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Text="{Binding State}" />

                                <Rectangle
                                    Grid.Column="1"
                                    Width="60"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Brush}"
                                    RadiusX="3"
                                    RadiusY="3"
                                    Stroke="{DynamicResource AtcApps.Brushes.Gray5}"
                                    StrokeThickness="1" />

                                <atc:ColorPicker
                                    Grid.Column="2"
                                    Margin="20,0,0,0"
                                    ColorValue="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </atc:GridEx>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="160"
                Command="{Binding RandomizePulseCommand}"
                Content="Randomize Pulse Color" />
            <Button
                MinWidth="120"
                Margin="10,0,0,0"
                Command="{Binding ResetPaletteCommand}"
                Content="Reset Palette" />
        </StackPanel>

    </atc:GridEx>

</UserControl>