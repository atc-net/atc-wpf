<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfNetwork.Diagnostics.WakeOnLanSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diagnostics="clr-namespace:Atc.Wpf.Network.Diagnostics;assembly=Atc.Wpf.Network"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=diagnostics:WakeOnLanViewModel}"
    d:DesignHeight="500"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <StackPanel>
        <GroupBox Padding="10" Header="Wake-on-LAN">
            <diagnostics:WakeOnLanView />
        </GroupBox>
        <GroupBox
            Margin="0,10,0,0"
            Padding="10"
            Header="WakeOnLanButton (bound to the same MAC address)">
            <diagnostics:WakeOnLanButton
                Width="160"
                HorizontalAlignment="Left"
                Content="Wake device"
                MacAddress="{Binding Path=MacAddress}" />
        </GroupBox>
    </StackPanel>

</UserControl>