<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfNetwork.Diagnostics.TracerouteSampleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diagnostics="clr-namespace:Atc.Wpf.Network.Diagnostics;assembly=Atc.Wpf.Network"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=diagnostics:TracerouteViewModel}"
    d:DesignHeight="500"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>
        <GroupBox Padding="10" Header="Traceroute">
            <diagnostics:TracerouteView />
        </GroupBox>
    </Grid>

</UserControl>