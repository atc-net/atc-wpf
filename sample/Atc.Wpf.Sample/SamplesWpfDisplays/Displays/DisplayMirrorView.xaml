<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfDisplays.Displays.DisplayMirrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfDisplays.Displays"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:DisplayMirrorDemoViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  The size properties are bound before the buffer: a control resizes a supplied buffer to its own size.  -->
        <DataTemplate DataType="{x:Type local:DisplayMirrorOledCard}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <atc:OledDisplay
                        Height="180"
                        PixelColumns="{Binding PixelColumns, Mode=OneTime}"
                        PixelRows="{Binding PixelRows, Mode=OneTime}"
                        Color="{Binding Color, Mode=OneTime}"
                        Buffer="{Binding Buffer, Mode=OneTime}" />
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DisplayMirrorColorCard}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <atc:ColorGraphicDisplay
                        Height="260"
                        PixelColumns="{Binding PixelColumns, Mode=OneTime}"
                        PixelRows="{Binding PixelRows, Mode=OneTime}"
                        PanelKind="{Binding PanelKind, Mode=OneTime}"
                        Buffer="{Binding Buffer, Mode=OneTime}" />
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DisplayMirrorCharacterCard}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <atc:CharacterDisplay
                        Columns="{Binding Columns, Mode=OneTime}"
                        Rows="{Binding Rows, Mode=OneTime}"
                        IsBacklightOn="{Binding IsBacklightOn}"
                        Buffer="{Binding Buffer, Mode=OneTime}" />
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DisplayMirrorEPaperCard}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <atc:EPaperDisplay
                        Height="180"
                        HasRed="{Binding HasRed, Mode=OneTime}"
                        PixelColumns="{Binding PixelColumns, Mode=OneTime}"
                        PixelRows="{Binding PixelRows, Mode=OneTime}"
                        VisibleColumns="{Binding VisibleColumns, Mode=OneTime}"
                        Buffer="{Binding Buffer, Mode=OneTime}" />
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DisplayMirrorMax7219Card}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <atc:SevenSegmentDisplay DigitCount="{Binding DigitCount, Mode=OneTime}" Buffer="{Binding Buffer, Mode=OneTime}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMatrix}" Value="True">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <atc:LedMatrixDisplay
                                                        Height="80"
                                                        LedColor="{Binding LedColor, Mode=OneTime}"
                                                        ModuleCount="{Binding ModuleCount, Mode=OneTime}"
                                                        Wiring="{Binding Wiring, Mode=OneTime}"
                                                        Buffer="{Binding Buffer, Mode=OneTime}" />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DisplayMirrorGraphicLcdCard}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <atc:GraphicLcdDisplay
                        Height="180"
                        Color="{Binding Color, Mode=OneTime}"
                        Buffer="{Binding Buffer, Mode=OneTime}" />
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DisplayMirrorPlaceholderCard}">
            <GroupBox
                Width="360"
                Margin="0,0,10,10"
                Header="{Binding Header}">
                <atc:UniformSpacingPanel Orientation="Vertical" Spacing="6">
                    <TextBlock
                        FontStyle="Italic"
                        Text="{Binding Reason}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatisticsText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastRejection}" TextWrapping="Wrap" />
                </atc:UniformSpacingPanel>
            </GroupBox>
        </DataTemplate>

    </UserControl.Resources>

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Receiver (choose the transport, ports and baud rate in the side panel)">
                    <atc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock VerticalAlignment="Center" Text="Serial port" />
                            <atc:SerialPortPicker
                                Width="280"
                                Value="{Binding SelectedSerialPort, Mode=TwoWay}"
                                WatermarkText="Select serial port..." />
                            <Button Command="{Binding StartCommand}" Content="Start" />
                            <Button Command="{Binding StopCommand}" Content="Stop" />
                            <Button Command="{Binding LoopbackCommand}" Content="Loopback demo" />
                        </atc:UniformSpacingPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StreamStatisticsText}" TextWrapping="Wrap" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="Add a display by hand (before its device sends a Describe)">
                    <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Display id" />
                        <atc:IntegerBox
                            Width="110"
                            Maximum="255"
                            Minimum="0"
                            Value="{Binding ManualDisplayId}" />
                        <ComboBox
                            MinWidth="300"
                            ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding SelectedPreset}" />
                        <Button Command="{Binding AddDisplayCommand}" Content="Add" />
                        <Button Command="{Binding ClearDisplaysCommand}" Content="Clear all" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="Displays">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>