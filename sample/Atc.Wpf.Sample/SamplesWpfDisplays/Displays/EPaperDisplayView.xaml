<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfDisplays.Displays.EPaperDisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfDisplays.Displays"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:EPaperDisplayDemoViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="E-paper display">
                    <!--  The size and colour properties are bound before the buffer: the control resizes a supplied buffer to its own size.  -->
                    <atc:EPaperDisplay
                        MaxWidth="768"
                        MaxHeight="440"
                        Margin="10"
                        HorizontalAlignment="Left"
                        HasRed="{Binding HasRed}"
                        PixelColumns="{Binding PixelColumns}"
                        PixelRows="{Binding PixelRows}"
                        VisibleColumns="{Binding VisibleColumns}"
                        RefreshFlashDuration="{Binding RefreshFlashDuration}"
                        Rotation="{Binding Rotation}"
                        ShowBezel="{Binding ShowBezel}"
                        ShowRefreshFlash="{Binding ShowRefreshFlash}"
                        Buffer="{Binding ActiveBuffer}"
                        Text="{Binding DisplayText}" />
                </GroupBox>

                <GroupBox Header="Module">
                    <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Preset" />
                        <ComboBox
                            MinWidth="320"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding SelectedPreset}" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="Emulator (GxEPD2: init, clear screen, a picture, a partial refresh on black/white panels, hibernate)">
                    <atc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding StartReplayCommand}" Content="Play capture" />
                            <Button Command="{Binding StopReplayCommand}" Content="Stop" />
                            <Button Command="{Binding StepReplayCommand}" Content="Step" />
                        </atc:UniformSpacingPanel>
                        <TextBlock Text="{Binding ReplayStatus}" TextWrapping="Wrap" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>