<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfDisplays.Displays.CharacterDisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfDisplays.Displays"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:CharacterDisplayDemoViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Character display">
                    <!--  The view model owns the buffer; the emulator writes into it, and it takes over the bound content properties.  -->
                    <atc:CharacterDisplay
                        MaxWidth="900"
                        MaxHeight="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Brightness="{Binding Brightness}"
                        Buffer="{Binding Buffer}"
                        CharacterRom="{Binding CharacterRom}"
                        Color="{Binding Color}"
                        Columns="{Binding Columns}"
                        CursorColumn="{Binding CursorColumn}"
                        CursorMode="{Binding CursorMode}"
                        CursorRow="{Binding CursorRow}"
                        CustomCharacters="{Binding CustomCharacters}"
                        GhostOpacity="{Binding GhostOpacity}"
                        IsBacklightOn="{Binding IsBacklightOn}"
                        IsDisplayOn="{Binding IsDisplayOn}"
                        Kind="{Binding Kind}"
                        Rows="{Binding Rows}"
                        ShowBezel="{Binding ShowBezel}"
                        Text="{Binding Text}" />
                </GroupBox>

                <GroupBox Header="Custom glyphs">
                    <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding ShowThermometerCommand}" Content="Thermometer" />
                        <Button Command="{Binding ShowBarGraphCommand}" Content="Bar graph" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="Emulator (20 x 4 clock + temperature capture)">
                    <atc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding ReplayLogicalCaptureCommand}" Content="Play HD44780 capture" />
                            <Button Command="{Binding ReplayI2cCaptureCommand}" Content="Play PCF8574 (I2C) capture" />
                            <Button Command="{Binding StepCommand}" Content="Step" />
                        </atc:UniformSpacingPanel>
                        <TextBlock Text="{Binding ReplayStatus}" TextWrapping="Wrap" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>