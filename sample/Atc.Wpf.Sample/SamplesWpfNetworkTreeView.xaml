<TreeView
    x:Class="Atc.Wpf.Sample.SamplesWpfNetworkTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DesignHeight="450"
    d:DesignWidth="230"
    mc:Ignorable="d">

    <TreeViewItem Header="Network">
        <sample:SampleTreeViewItem
            Header="NetworkScanner"
            IsExpanded="True"
            SamplePath="Scanner.NetworkScannerSampleView" />
        <sample:SampleTreeViewItem Header="OnvifCamera" SamplePath="Onvif.OnvifCameraSampleView" />
        <sample:SampleTreeViewItem Header="ServiceDiscovery" SamplePath="Discovery.ServiceDiscoverySampleView" />
        <sample:SampleTreeViewItem Header="VncViewer" SamplePath="Vnc.VncViewerSampleView" />
    </TreeViewItem>

    <TreeViewItem Header="Clients">
        <sample:SampleTreeViewItem Header="TcpClient" SamplePath="Clients.TcpClientSampleView" />
        <sample:SampleTreeViewItem Header="UdpClient" SamplePath="Clients.UdpClientSampleView" />
    </TreeViewItem>

    <TreeViewItem Header="Diagnostics">
        <sample:SampleTreeViewItem Header="NtpTime" SamplePath="Diagnostics.NtpTimeSampleView" />
        <sample:SampleTreeViewItem Header="Traceroute" SamplePath="Diagnostics.TracerouteSampleView" />
        <sample:SampleTreeViewItem Header="WakeOnLan" SamplePath="Diagnostics.WakeOnLanSampleView" />
    </TreeViewItem>

    <TreeViewItem Header="ValueConverters">
        <sample:SampleTreeViewItem
            Header="ConnectionStateToColor"
            SamplePath="ValueConverters.ConnectionStateToColorValueConverterSampleView" />
        <sample:SampleTreeViewItem
            Header="ConnectionStateToBrush"
            SamplePath="ValueConverters.ConnectionStateToBrushValueConverterSampleView" />
    </TreeViewItem>

</TreeView>