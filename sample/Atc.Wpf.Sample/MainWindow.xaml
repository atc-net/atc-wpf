<atcSample:SampleMainWindow
    x:Class="Atc.Wpf.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atcSample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    xmlns:sample="clr-namespace:Atc.Wpf.Sample"
    Title="..:: Atc.Wpf.Sample ::.."
    Icon="Assets\atc.png">

    <!--  The UI tests read the categories from here: Key names the tab (Tab{Key}) and the tree (StvSamples{Key})  -->
    <atcSample:SampleCategory
        Header="Wpf"
        Key="Wpf"
        TreeType="{x:Type sample:SamplesWpfTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Components"
        Key="WpfComponents"
        TreeType="{x:Type sample:SamplesWpfComponentsTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Controls"
        Key="WpfControls"
        TreeType="{x:Type sample:SamplesWpfControlsTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Displays"
        Key="WpfDisplays"
        TreeType="{x:Type sample:SamplesWpfDisplaysTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.FontIcons"
        Key="WpfFontIcons"
        TreeType="{x:Type sample:SamplesWpfFontIconsTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Forms"
        Key="WpfForms"
        TreeType="{x:Type sample:SamplesWpfFormsTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Hardware"
        Key="WpfHardware"
        TreeType="{x:Type sample:SamplesWpfHardwareTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Network"
        Key="WpfNetwork"
        TreeType="{x:Type sample:SamplesWpfNetworkTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.SourceGenerators"
        Key="WpfSourceGenerators"
        TreeType="{x:Type sample:SamplesWpfSourceGeneratorsTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.Theming"
        Key="WpfTheming"
        TreeType="{x:Type sample:SamplesWpfThemingTreeView}" />
    <atcSample:SampleCategory
        Header="Wpf.UndoRedo"
        Key="WpfUndoRedo"
        TreeType="{x:Type sample:SamplesWpfUndoRedoTreeView}" />

</atcSample:SampleMainWindow>