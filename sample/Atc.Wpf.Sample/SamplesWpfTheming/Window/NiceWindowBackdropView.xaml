<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfTheming.Window.NiceWindowBackdropView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:controlzEx="clr-namespace:ControlzEx.Theming;assembly=ControlzEx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <atc:AutoGrid Columns="*" Rows="Auto,*">

        <GroupBox
            Margin="0,0,0,10"
            Padding="10"
            Header="Features">
            <TextBlock TextWrapping="Wrap">
                NiceWindow.BackdropType draws a Windows 11 system backdrop (Mica, Acrylic or Tabbed) behind the window.
                While Windows applies it, IsBackdropActive is true and the window and title bar backgrounds turn transparent so the backdrop shows through.
                On Windows 10, in high contrast, or with AllowsTransparency, the window keeps its theme background.
                Backdrops need Windows 11 22H2 or later, with transparency effects turned on, and only show while the window is active.
            </TextBlock>
        </GroupBox>

        <GroupBox Header="Open a window with a backdrop">
            <atc:UniformSpacingPanel
                Margin="10"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    Width="120"
                    AutomationProperties.AutomationId="OpenMicaWindow"
                    Click="OnOpenWindowClick"
                    Content="Mica"
                    Tag="{x:Static controlzEx:WindowBackdropType.Mica}" />
                <Button
                    Width="120"
                    AutomationProperties.AutomationId="OpenAcrylicWindow"
                    Click="OnOpenWindowClick"
                    Content="Acrylic"
                    Tag="{x:Static controlzEx:WindowBackdropType.Acrylic}" />
                <Button
                    Width="120"
                    AutomationProperties.AutomationId="OpenTabbedWindow"
                    Click="OnOpenWindowClick"
                    Content="Tabbed"
                    Tag="{x:Static controlzEx:WindowBackdropType.Tabbed}" />
                <Button
                    Width="120"
                    AutomationProperties.AutomationId="OpenNoBackdropWindow"
                    Click="OnOpenWindowClick"
                    Content="None"
                    Tag="{x:Static controlzEx:WindowBackdropType.None}" />
            </atc:UniformSpacingPanel>
        </GroupBox>

    </atc:AutoGrid>

</UserControl>