<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.DataDisplay.SegmentedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataDisplay="clr-namespace:Atc.Wpf.Controls.DataDisplay;assembly=Atc.Wpf.Controls"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.DataDisplay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:DoubleToCornerRadiusValueConverter x:Key="DoubleToCornerRadiusConverter" />
    </UserControl.Resources>

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <dataDisplay:Segmented
                    CornerRadius="{Binding CornerRadius, Converter={StaticResource DoubleToCornerRadiusConverter}}"
                    EqualSegmentWidth="{Binding EqualSegmentWidth}"
                    IsJoined="{Binding IsJoined}"
                    Orientation="{Binding Orientation}"
                    SelectedIndex="{Binding SelectedIndex}"
                    SelectionMode="{Binding SelectionMode}"
                    Size="{Binding Size}">
                    <dataDisplay:SegmentedItem Content="Day" />
                    <dataDisplay:SegmentedItem Content="Week" />
                    <dataDisplay:SegmentedItem Content="Month" />
                    <dataDisplay:SegmentedItem Content="Year" />
                </dataDisplay:Segmented>

                <!--  Weekday picker (multiple)  -->
                <atc:GroupBoxExpander Header="Weekday picker (SelectionMode=Multiple)">
                    <StackPanel Margin="10">
                        <dataDisplay:Segmented
                            x:Name="InteractiveBox"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="InteractiveBox"
                            AutomationProperties.Name="Weekdays"
                            SelectedKeys="{Binding WeekdayKeys}"
                            SelectionMode="Multiple">
                            <dataDisplay:SegmentedItem Key="mon" Content="Mon" />
                            <dataDisplay:SegmentedItem Key="tue" Content="Tue" />
                            <dataDisplay:SegmentedItem Key="wed" Content="Wed" />
                            <dataDisplay:SegmentedItem Key="thu" Content="Thu" />
                            <dataDisplay:SegmentedItem Key="fri" Content="Fri" />
                            <dataDisplay:SegmentedItem Key="sat" Content="Sat" />
                            <dataDisplay:SegmentedItem Key="sun" Content="Sun" />
                        </dataDisplay:Segmented>
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per toggle):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Text style (icon only, multiple)  -->
                <atc:GroupBoxExpander Header="Text style (IconOnly, SelectionMode=Multiple, Size=Small)">
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <dataDisplay:Segmented
                            EqualSegmentWidth="False"
                            IconOnly="True"
                            SelectedKeys="{Binding TextStyleKeys}"
                            SelectionMode="Multiple"
                            Size="Small">
                            <dataDisplay:SegmentedItem Key="bold" Content="Bold">
                                <dataDisplay:SegmentedItem.Icon>
                                    <TextBlock
                                        MinWidth="12"
                                        FontWeight="Bold"
                                        Text="B"
                                        TextAlignment="Center" />
                                </dataDisplay:SegmentedItem.Icon>
                            </dataDisplay:SegmentedItem>
                            <dataDisplay:SegmentedItem Key="italic" Content="Italic">
                                <dataDisplay:SegmentedItem.Icon>
                                    <TextBlock
                                        MinWidth="12"
                                        FontStyle="Italic"
                                        Text="I"
                                        TextAlignment="Center" />
                                </dataDisplay:SegmentedItem.Icon>
                            </dataDisplay:SegmentedItem>
                            <dataDisplay:SegmentedItem Key="underline" Content="Underline">
                                <dataDisplay:SegmentedItem.Icon>
                                    <TextBlock
                                        MinWidth="12"
                                        Text="U"
                                        TextAlignment="Center"
                                        TextDecorations="Underline" />
                                </dataDisplay:SegmentedItem.Icon>
                            </dataDisplay:SegmentedItem>
                        </dataDisplay:Segmented>
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding TextStyleSummary}" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Vertical  -->
                <atc:GroupBoxExpander Header="Map layers (Orientation=Vertical; Multiple and SingleOrNone)">
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <dataDisplay:Segmented
                            Width="180"
                            VerticalAlignment="Top"
                            CornerRadius="8"
                            Orientation="Vertical"
                            SelectedKeys="{Binding MapLayerKeys}"
                            SelectionMode="Multiple">
                            <dataDisplay:SegmentedItem Key="roads" Content="Roads" />
                            <dataDisplay:SegmentedItem Key="terrain" Content="Terrain" />
                            <dataDisplay:SegmentedItem Key="traffic" Content="Traffic" />
                            <dataDisplay:SegmentedItem
                                Key="transit"
                                Content="Transit (unavailable)"
                                IsEnabled="False" />
                        </dataDisplay:Segmented>
                        <dataDisplay:Segmented
                            Width="180"
                            Margin="24,0,0,0"
                            VerticalAlignment="Top"
                            Orientation="Vertical"
                            SelectedIndex="1"
                            SelectionMode="SingleOrNone">
                            <dataDisplay:SegmentedItem Content="Satellite" />
                            <dataDisplay:SegmentedItem Content="Hybrid" />
                            <dataDisplay:SegmentedItem Content="Standard" />
                        </dataDisplay:Segmented>
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Separated pills  -->
                <atc:GroupBoxExpander Header="Notification channels (IsJoined=False, ItemSpacing=8) and sizes">
                    <StackPanel Margin="10">
                        <dataDisplay:Segmented
                            HorizontalAlignment="Left"
                            CornerRadius="14"
                            EqualSegmentWidth="False"
                            IsJoined="False"
                            ItemSpacing="8"
                            SelectedKeys="{Binding ChannelKeys}"
                            SelectionMode="Multiple">
                            <dataDisplay:SegmentedItem Key="email" Content="E-mail" />
                            <dataDisplay:SegmentedItem Key="sms" Content="SMS" />
                            <dataDisplay:SegmentedItem Key="push" Content="Push" />
                        </dataDisplay:Segmented>
                        <TextBlock
                            Margin="0,15,0,10"
                            FontWeight="Bold"
                            Text="Sizes (Small, Medium, Large)" />
                        <StackPanel Orientation="Horizontal">
                            <dataDisplay:Segmented
                                VerticalAlignment="Center"
                                SelectedIndex="0"
                                Size="Small">
                                <dataDisplay:SegmentedItem Content="Day" />
                                <dataDisplay:SegmentedItem Content="Week" />
                            </dataDisplay:Segmented>
                            <dataDisplay:Segmented
                                Margin="12,0"
                                VerticalAlignment="Center"
                                SelectedIndex="0">
                                <dataDisplay:SegmentedItem Content="Day" />
                                <dataDisplay:SegmentedItem Content="Week" />
                            </dataDisplay:Segmented>
                            <dataDisplay:Segmented
                                VerticalAlignment="Center"
                                SelectedIndex="0"
                                Size="Large">
                                <dataDisplay:SegmentedItem Content="Day" />
                                <dataDisplay:SegmentedItem Content="Week" />
                            </dataDisplay:Segmented>
                        </StackPanel>
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  With Icons  -->
                <dataDisplay:Segmented SelectedIndex="0">
                    <dataDisplay:SegmentedItem Content="List">
                        <dataDisplay:SegmentedItem.Icon>
                            <TextBlock FontSize="14" Text="&#x2630;" />
                        </dataDisplay:SegmentedItem.Icon>
                    </dataDisplay:SegmentedItem>
                    <dataDisplay:SegmentedItem Content="Grid">
                        <dataDisplay:SegmentedItem.Icon>
                            <TextBlock FontSize="14" Text="&#x25A6;" />
                        </dataDisplay:SegmentedItem.Icon>
                    </dataDisplay:SegmentedItem>
                    <dataDisplay:SegmentedItem Content="Map">
                        <dataDisplay:SegmentedItem.Icon>
                            <TextBlock FontSize="14" Text="&#x2691;" />
                        </dataDisplay:SegmentedItem.Icon>
                    </dataDisplay:SegmentedItem>
                </dataDisplay:Segmented>

                <!--  Interactive with Event  -->
                <StackPanel>
                    <dataDisplay:Segmented
                        x:Name="InteractiveSegmented"
                        SelectedIndex="0"
                        SelectionChanged="OnSelectionChanged">
                        <dataDisplay:SegmentedItem Content="All" />
                        <dataDisplay:SegmentedItem Content="Active" />
                        <dataDisplay:SegmentedItem Content="Completed" />
                        <dataDisplay:SegmentedItem Content="Archived" />
                    </dataDisplay:Segmented>
                    <TextBlock
                        x:Name="SelectionStatus"
                        Margin="0,10,0,0"
                        FontStyle="Italic"
                        Foreground="Gray"
                        Text="Click a segment to see the selection change event." />
                </StackPanel>

                <!--  Sizing &amp; Styling  -->
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="Bold"
                        Text="Proportional width (EqualSegmentWidth=False)" />
                    <dataDisplay:Segmented EqualSegmentWidth="False" SelectedIndex="1">
                        <dataDisplay:SegmentedItem Content="S" />
                        <dataDisplay:SegmentedItem Content="Medium" />
                        <dataDisplay:SegmentedItem Content="Extra Large" />
                    </dataDisplay:Segmented>

                    <TextBlock
                        Margin="0,15,0,10"
                        FontWeight="Bold"
                        Text="Custom colors" />
                    <dataDisplay:Segmented
                        CornerRadius="12"
                        SelectedBackground="#4CAF50"
                        SelectedForeground="White"
                        SelectedIndex="0">
                        <dataDisplay:SegmentedItem Content="Low" />
                        <dataDisplay:SegmentedItem Content="Medium" />
                        <dataDisplay:SegmentedItem Content="High" />
                    </dataDisplay:Segmented>
                </StackPanel>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>
</UserControl>