<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.DataDisplay.ChipGroupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.DataDisplay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:ChipGroupDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Interactive (use the side panel)">
                    <StackPanel Margin="10">
                        <atc:ChipGroup
                            x:Name="InteractiveBox"
                            MaxWidth="520"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="InteractiveBox"
                            AutomationProperties.Name="Fruits"
                            ChipSize="{Binding Path=ChipSize}"
                            ChipVariant="{Binding Path=ChipVariant}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            Items="{Binding Path=Fruits}"
                            Orientation="{Binding Path=Orientation}"
                            SelectionMode="{Binding Path=SelectionMode}"
                            ShowAllChip="{Binding Path=ShowAllChip}"
                            ShowCheckMark="{Binding Path=ShowCheckMark}"
                            Wrap="{Binding Path=Wrap}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per toggle or All chip click):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Log-level filter  -->
                <atc:GroupBoxExpander Header="Log-level filter (filled, All chip, icons and counts)">
                    <atc:ChipGroup
                        x:Name="LogLevelGroup"
                        Margin="10"
                        HorizontalAlignment="Left"
                        ItemCounts="{Binding Path=LogLevelCounts}"
                        Items="{Binding Path=LogLevels}"
                        SelectedKeys="{Binding Path=SelectedLogLevels}"
                        ShowAllChip="True" />
                </atc:GroupBoxExpander>

                <!--  Status filter  -->
                <atc:GroupBoxExpander Header="Status filter (outlined, single selection - arrow keys move and select)">
                    <atc:ChipGroup
                        Margin="10"
                        HorizontalAlignment="Left"
                        ChipVariant="Outlined"
                        Items="{Binding Path=Statuses}"
                        SelectedKeys="{Binding Path=SelectedStatuses}"
                        SelectionMode="Single" />
                </atc:GroupBoxExpander>

                <!--  Wrap vs one line  -->
                <atc:GroupBoxExpander Header="Wrap (top) vs one line that scrolls (bottom)">
                    <StackPanel Margin="10">
                        <Border
                            Width="360"
                            Padding="6"
                            HorizontalAlignment="Left"
                            BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                            BorderThickness="1">
                            <atc:ChipGroup
                                ChipSize="Small"
                                Items="{Binding Path=Facets}"
                                SelectedKeys="{Binding Path=SelectedFacets}" />
                        </Border>
                        <Border
                            Width="360"
                            Margin="0,10,0,0"
                            Padding="6"
                            HorizontalAlignment="Left"
                            BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                            BorderThickness="1">
                            <atc:ChipGroup
                                ChipSize="Small"
                                Items="{Binding Path=Facets}"
                                SelectedKeys="{Binding Path=SelectedFacets}"
                                Wrap="False" />
                        </Border>
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Vertical with a limit and a disabled key  -->
                <atc:GroupBoxExpander Header="Vertical, outlined, at most 3 toppings (Pineapple is sold out)">
                    <atc:ChipGroup
                        Margin="10"
                        HorizontalAlignment="Left"
                        ChipVariant="Outlined"
                        DisabledKeys="{Binding Path=SoldOutToppings}"
                        ItemSpacing="6"
                        Items="{Binding Path=Toppings}"
                        MaxSelectionCount="3"
                        Orientation="Vertical"
                        SelectedKeys="{Binding Path=SelectedToppings}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>
