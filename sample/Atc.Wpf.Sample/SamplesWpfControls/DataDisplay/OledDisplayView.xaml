<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.DataDisplay.OledDisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.DataDisplay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:OledDisplayDemoViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="OLED display">
                    <!--  Text mode shows the control's own buffer (Buffer is null); Frame and Replay modes show a buffer owned by the view model.  -->
                    <atc:OledDisplay
                        x:Name="Oled"
                        MaxWidth="768"
                        MaxHeight="440"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Buffer="{Binding ActiveBuffer}"
                        CharacterRom="{Binding CharacterRom}"
                        Color="{Binding Color}"
                        GhostOpacity="{Binding GhostOpacity}"
                        IsInverted="{Binding IsInverted}"
                        PixelColumns="{Binding PixelColumns}"
                        PixelRows="{Binding PixelRows}"
                        ShowBezel="{Binding ShowBezel}"
                        Text="{Binding DisplayText}"
                        YellowZoneRows="{Binding YellowZoneRows}" />
                </GroupBox>

                <GroupBox Header="Module">
                    <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock VerticalAlignment="Center" Text="Preset" />
                        <ComboBox
                            MinWidth="280"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding SelectedPreset}" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="Emulator (border, &quot;Hello ESP32&quot; and a filled box, as the library sends it)">
                    <atc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding StartReplayCommand}" Content="Play capture" />
                            <Button Command="{Binding StopReplayCommand}" Content="Stop" />
                            <Button Command="{Binding StepReplayCommand}" Content="Step" />
                        </atc:UniformSpacingPanel>
                        <TextBlock Text="{Binding ReplayStatus}" TextWrapping="Wrap" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>