<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Clocks.AnalogClockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Clocks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:AnalogClockDemoViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Theme colors">
                    <atc:AnalogClock
                        Width="250"
                        Height="250"
                        FollowCurrentTime="{Binding FollowCurrentTime}"
                        ShowAmPm="{Binding ShowAmPm}"
                        ShowNumbers="{Binding ShowNumbers}"
                        ShowSeconds="{Binding ShowSeconds}"
                        Time="{Binding Time}" />
                </GroupBox>

                <GroupBox Header="Custom colors">
                    <atc:AnalogClock
                        Width="250"
                        Height="250"
                        AmPmColor="{Binding AmPmColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        ClockBackgroundColor="{Binding ClockBackgroundColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        ClockBorderColor="{Binding ClockBorderColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        ClockCenterDotColor="{Binding ClockCenterDotColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        HourHandColor="{Binding HourHandColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        HourIndicatorColor="{Binding HourIndicatorColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        MinuteHandColor="{Binding MinuteHandColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        MinuteIndicatorColor="{Binding MinuteIndicatorColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        NumberColor="{Binding NumberColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        SecondHandColor="{Binding SecondHandColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        FollowCurrentTime="{Binding FollowCurrentTime}"
                        ShowAmPm="{Binding ShowAmPm}"
                        ShowNumbers="{Binding ShowNumbers}"
                        ShowSeconds="{Binding ShowSeconds}"
                        Time="{Binding Time}" />
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>