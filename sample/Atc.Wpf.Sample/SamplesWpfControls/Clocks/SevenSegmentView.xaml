<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Clocks.SevenSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Clocks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:SevenSegmentDemoViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Theme colors">
                    <atc:SevenSegment
                        Width="90"
                        Height="150"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Left"
                        BlurRadius="{Binding BlurRadius}"
                        Digit="{Binding Digit}"
                        NumberMinimumOpacity="{Binding NumberMinimumOpacity}"
                        PlayAnimation="{Binding PlayAnimation}"
                        ShowColon="{Binding ShowColon}"
                        ShowDot="{Binding ShowDot}" />
                </GroupBox>

                <GroupBox Header="Custom colors">
                    <atc:SevenSegment
                        Width="90"
                        Height="150"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Left"
                        BlurRadius="{Binding BlurRadius}"
                        ColonColor="{Binding ColonColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        NumberColor="{Binding NumberColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        Digit="{Binding Digit}"
                        NumberMinimumOpacity="{Binding NumberMinimumOpacity}"
                        PlayAnimation="{Binding PlayAnimation}"
                        ShowColon="{Binding ShowColon}"
                        ShowDot="{Binding ShowDot}" />
                </GroupBox>

                <GroupBox Header="All digits">
                    <atc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="0" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="1" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="2" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="3" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="4" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="5" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="6" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="7" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="8" />
                        <atc:SevenSegment
                            Width="30"
                            Height="50"
                            Digit="9" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>