<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Clocks.DigitalClockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Clocks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:DigitalClockDemoViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Theme colors">
                    <atc:DigitalClock
                        Height="100"
                        AnimateColon="{Binding AnimateColon}"
                        FollowCurrentTime="{Binding FollowCurrentTime}"
                        NumberBlurRadius="{Binding NumberBlurRadius}"
                        PlayAnimation="{Binding PlayAnimation}"
                        ShowColon="{Binding ShowColon}"
                        ShowSeconds="{Binding ShowSeconds}"
                        Time="{Binding Time}" />
                </GroupBox>

                <GroupBox Header="Custom colors">
                    <atc:DigitalClock
                        Height="100"
                        ColonColor="{Binding ColonColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        NumberColor="{Binding NumberColor, Converter={x:Static atcValueConverters:ColorToBrushValueConverter.Instance}}"
                        AnimateColon="{Binding AnimateColon}"
                        FollowCurrentTime="{Binding FollowCurrentTime}"
                        NumberBlurRadius="{Binding NumberBlurRadius}"
                        PlayAnimation="{Binding PlayAnimation}"
                        ShowColon="{Binding ShowColon}"
                        ShowSeconds="{Binding ShowSeconds}"
                        Time="{Binding Time}" />
                </GroupBox>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>