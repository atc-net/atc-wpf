<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.MultiColumnComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:MultiColumnComboBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Customers: explicit columns, chips (use the side panel)">
                    <StackPanel Margin="10">
                        <atc:MultiColumnComboBox
                            x:Name="InteractiveBox"
                            Width="360"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Pick customers"
                            AutomationProperties.AutomationId="InteractiveBox"
                            CommitMode="{Binding Path=CommitMode}"
                            DisplayMemberPath="Name"
                            DisplayMode="{Binding Path=DisplayMode}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            IsFilterVisible="{Binding Path=IsFilterVisible}"
                            ItemsSource="{Binding Path=Customers}"
                            KeepSelectedOnTop="{Binding Path=KeepSelectedOnTop}"
                            KeyMemberPath="Number"
                            MaxDropDownHeight="320"
                            SelectedKeys="{Binding Path=CustomerKeys}">
                            <atc:MultiColumnComboBox.Columns>
                                <DataGridTextColumn Binding="{Binding Path=Number}" Header="No." />
                                <DataGridTextColumn Binding="{Binding Path=Name}" Header="Name" />
                                <DataGridTextColumn Binding="{Binding Path=City}" Header="City" />
                                <DataGridTextColumn Binding="{Binding Path=Contact.Email}" Header="E-mail" />
                            </atc:MultiColumnComboBox.Columns>
                        </atc:MultiColumnComboBox>
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per row, select all or chip removal):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Large  -->
                <atc:GroupBoxExpander Header="10,000 spare parts: virtualized grid, debounced filter, count summary">
                    <atc:MultiColumnComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick parts"
                        DisplayMemberPath="PartNumber"
                        DisplayMode="Count"
                        ItemsSource="{Binding Path=Parts}"
                        KeyMemberPath="PartNumber"
                        MaxDropDownHeight="360"
                        SelectedKeys="{Binding Path=PartKeys}">
                        <atc:MultiColumnComboBox.Columns>
                            <DataGridTextColumn Binding="{Binding Path=PartNumber}" Header="Part no." />
                            <DataGridTextColumn Binding="{Binding Path=Description}" Header="Description" />
                            <DataGridTextColumn Binding="{Binding Path=Category}" Header="Category" />
                            <DataGridTextColumn Binding="{Binding Path=Stock}" Header="Stock" />
                        </atc:MultiColumnComboBox.Columns>
                    </atc:MultiColumnComboBox>
                </atc:GroupBoxExpander>

                <!--  OK / Cancel  -->
                <atc:GroupBoxExpander Header="OK / Cancel (Deferred commit mode), ticked rows kept on top">
                    <atc:MultiColumnComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick customers"
                        CommitMode="Deferred"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Path=DeferredCustomers}"
                        KeepSelectedOnTop="True"
                        KeyMemberPath="Number"
                        SelectedKeys="{Binding Path=DeferredCustomerKeys}">
                        <atc:MultiColumnComboBox.Columns>
                            <DataGridTextColumn Binding="{Binding Path=Number}" Header="No." />
                            <DataGridTextColumn Binding="{Binding Path=Name}" Header="Name" />
                            <DataGridTextColumn Binding="{Binding Path=Country}" Header="Country" />
                        </atc:MultiColumnComboBox.Columns>
                    </atc:MultiColumnComboBox>
                </atc:GroupBoxExpander>

                <!--  Auto-generated  -->
                <atc:GroupBoxExpander Header="Auto-generated columns (one per public property)">
                    <atc:MultiColumnComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick users"
                        AutoGenerateColumns="True"
                        DisplayMemberPath="FullName"
                        ItemsSource="{Binding Path=Users}"
                        KeyMemberPath="UserName"
                        SelectedKeys="{Binding Path=UserKeys}" />
                </atc:GroupBoxExpander>

                <!--  Limit and disabled rows  -->
                <atc:GroupBoxExpander Header="At most 3 customers, inactive customers disabled, filter on name and e-mail only">
                    <atc:MultiColumnComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick up to 3 customers"
                        DisplayMemberPath="Name"
                        FilterMemberPaths="Name, Contact.Email"
                        IsEnabledMemberPath="IsActive"
                        ItemsSource="{Binding Path=LimitCustomers}"
                        KeyMemberPath="Number"
                        MaxSelectionCount="3"
                        SelectedKeys="{Binding Path=LimitCustomerKeys}">
                        <atc:MultiColumnComboBox.Columns>
                            <DataGridTextColumn Binding="{Binding Path=Name}" Header="Name" />
                            <DataGridTextColumn Binding="{Binding Path=City}" Header="City" />
                            <DataGridTextColumn Binding="{Binding Path=IsActive}" Header="Active" />
                        </atc:MultiColumnComboBox.Columns>
                    </atc:MultiColumnComboBox>
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>
