<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.MultiSelectComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:MultiSelectComboBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Interactive (use the side panel)">
                    <StackPanel Margin="10">
                        <atc:MultiSelectComboBox
                            x:Name="InteractiveBox"
                            Width="220"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Source systems"
                            AutomationProperties.AutomationId="InteractiveBox"
                            CommitMode="{Binding Path=CommitMode}"
                            DisplayMode="{Binding Path=DisplayMode}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            Items="{Binding Path=SourceSystems}"
                            MaxNamesInSummary="{Binding Path=MaxNamesInSummary}"
                            NoneText="{Binding Path=NoneText}"
                            ShowClearButton="{Binding Path=ShowClearButton}"
                            ShowSelectAllRow="{Binding Path=ShowSelectAllRow}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per tick, Select all or Clear):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Toolbar  -->
                <atc:GroupBoxExpander Header="In a toolbar (same height as the other toolbar items)">
                    <ToolBarTray Margin="10" HorizontalAlignment="Left">
                        <ToolBar>
                            <Button Content="Refresh" />
                            <Separator Margin="5,0" />
                            <ComboBox Width="140" SelectedIndex="0">
                                <ComboBoxItem Content="Last hour" />
                                <ComboBoxItem Content="Today" />
                            </ComboBox>
                            <Separator Margin="5,0" />
                            <atc:MultiSelectComboBox
                                Width="200"
                                atc:TextBoxHelper.Watermark="Log levels"
                                Items="{Binding Path=LogLevels}"
                                SelectedKeys="{Binding Path=SelectedLogLevels}" />
                            <Separator Margin="5,0" />
                            <atc:MultiSelectComboBox
                                Width="200"
                                atc:TextBoxHelper.Watermark="Log levels (chips)"
                                DisplayMode="Chips"
                                Items="{Binding Path=LogLevels}"
                                SelectedKeys="{Binding Path=SelectedLogLevels}" />
                            <Separator Margin="5,0" />
                            <TextBox Width="150" Text="Search" />
                        </ToolBar>
                    </ToolBarTray>
                </atc:GroupBoxExpander>

                <!--  Display modes  -->
                <atc:GroupBoxExpander Header="Display modes side by side: Text, Chips, Count (one shared selection)">
                    <StackPanel Margin="10">
                        <WrapPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Margin="0,0,0,4" Text="Text" />
                                <atc:MultiSelectComboBox
                                    Width="240"
                                    atc:TextBoxHelper.Watermark="Log levels"
                                    DisplayMode="Text"
                                    Items="{Binding Path=LogLevels}"
                                    SelectedKeys="{Binding Path=SelectedDisplayModeLogLevels}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Margin="0,0,0,4" Text="Chips (responsive &quot;+N&quot;)" />
                                <atc:MultiSelectComboBox
                                    Width="240"
                                    atc:TextBoxHelper.Watermark="Log levels"
                                    DisplayMode="Chips"
                                    Items="{Binding Path=LogLevels}"
                                    SelectedKeys="{Binding Path=SelectedDisplayModeLogLevels}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Margin="0,0,0,4" Text="Count" />
                                <atc:MultiSelectComboBox
                                    Width="240"
                                    atc:TextBoxHelper.Watermark="Log levels"
                                    DisplayMode="Count"
                                    Items="{Binding Path=LogLevels}"
                                    SelectedKeys="{Binding Path=SelectedDisplayModeLogLevels}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Margin="0,0,0,4" Text="Chips, MaxVisibleChips=&quot;2&quot;" />
                                <atc:MultiSelectComboBox
                                    Width="320"
                                    atc:TextBoxHelper.Watermark="Log levels"
                                    DisplayMode="Chips"
                                    MaxVisibleChips="2"
                                    Items="{Binding Path=LogLevels}"
                                    SelectedKeys="{Binding Path=SelectedDisplayModeLogLevels}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Margin="0,0,0,4" Text="Chips, ChipsWrap=&quot;True&quot; (grows in height)" />
                                <atc:MultiSelectComboBox
                                    Width="240"
                                    atc:TextBoxHelper.Watermark="Log levels"
                                    ChipsWrap="True"
                                    DisplayMode="Chips"
                                    Items="{Binding Path=LogLevels}"
                                    SelectedKeys="{Binding Path=SelectedDisplayModeLogLevels}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Chips with remove buttons  -->
                <atc:GroupBoxExpander Header="Chips: the remove button on a chip unticks it without opening; Backspace removes the last chip">
                    <StackPanel Margin="10">
                        <atc:MultiSelectComboBox
                            x:Name="ChipsBox"
                            Width="320"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Source systems"
                            AutomationProperties.AutomationId="ChipsBox"
                            DisplayMode="Chips"
                            Items="{Binding Path=SourceSystems}"
                            SelectedKeys="{Binding Path=SelectedChipsSourceSystems}" />
                        <TextBlock
                            x:Name="ChipsLog"
                            Margin="0,10,0,0"
                            AutomationProperties.AutomationId="ChipsLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Selection limit  -->
                <atc:GroupBoxExpander Header="Selection limit: at most 3 (the other items are disabled at the limit)">
                    <atc:MultiSelectComboBox
                        Width="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Up to three log levels"
                        DisplayMode="Chips"
                        Items="{Binding Path=LogLevels}"
                        MaxSelectionCount="3"
                        SelectedKeys="{Binding Path=SelectedLimitedLogLevels}" />
                </atc:GroupBoxExpander>

                <!--  Deferred commit  -->
                <atc:GroupBoxExpander Header="Deferred commit: ticks apply on OK; Cancel, Esc or a click outside discard them">
                    <StackPanel Margin="10">
                        <atc:MultiSelectComboBox
                            x:Name="DeferredBox"
                            Width="240"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Log levels"
                            AutomationProperties.AutomationId="DeferredBox"
                            CommitMode="Deferred"
                            Items="{Binding Path=LogLevels}"
                            SelectedKeys="{Binding Path=SelectedDeferredLogLevels}" />
                        <TextBlock
                            x:Name="DeferredLog"
                            Margin="0,10,0,0"
                            AutomationProperties.AutomationId="DeferredLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Groups  -->
                <atc:GroupBoxExpander Header="Grouped items: a group header ticks or unticks its shown items">
                    <atc:MultiSelectComboBox
                        Width="240"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Foods"
                        DisplayMode="Chips"
                        IsFilterVisible="True"
                        ItemGroups="{Binding Path=FoodGroups}"
                        Items="{Binding Path=Foods}"
                        SelectedKeys="{Binding Path=SelectedFoods}" />
                </atc:GroupBoxExpander>

                <!--  Live data  -->
                <atc:GroupBoxExpander Header="Live data: new source systems are ticked (SelectNewItems), removed ones are unticked">
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <atc:MultiSelectComboBox
                            Width="220"
                            atc:TextBoxHelper.Watermark="Source systems"
                            Items="{Binding Path=LiveSourceSystems}"
                            SelectNewItems="True"
                            SelectedKeys="{Binding Path=SelectedLiveSourceSystems}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding Path=AddSourceSystemCommand}"
                            Content="Add a source system" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding Path=RemoveFirstSourceSystemCommand}"
                            Content="Remove the first one" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Summary texts  -->
                <atc:GroupBoxExpander Header="Summary texts: names, count, All, None">
                    <WrapPanel Margin="10">
                        <atc:MultiSelectComboBox
                            Width="200"
                            Margin="0,0,10,0"
                            Items="{Binding Path=SourceSystems}"
                            NoneText="No source system" />
                        <atc:MultiSelectComboBox
                            Width="200"
                            Margin="0,0,10,0"
                            AllText="Every source system"
                            Items="{Binding Path=SourceSystems}"
                            SelectedKeys="{Binding Path=SelectedAllSourceSystems}" />
                        <atc:MultiSelectComboBox
                            Width="200"
                            CountFormat="{}{0}/{1} countries"
                            Items="{Binding Path=Countries}"
                            SelectedKeys="{Binding Path=SelectedCountries}" />
                    </WrapPanel>
                </atc:GroupBoxExpander>

                <!--  1,000 items  -->
                <atc:GroupBoxExpander Header="1,000 items with filter (virtualized)">
                    <atc:MultiSelectComboBox
                        Width="220"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick items"
                        Items="{Binding Path=ManyItems}"
                        MaxDropDownHeight="320" />
                </atc:GroupBoxExpander>

                <!--  Disabled  -->
                <atc:GroupBoxExpander Header="Disabled">
                    <atc:MultiSelectComboBox
                        Width="220"
                        Margin="10"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Items="{Binding Path=LogLevels}"
                        SelectedKeys="{Binding Path=SelectedLogLevels}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>