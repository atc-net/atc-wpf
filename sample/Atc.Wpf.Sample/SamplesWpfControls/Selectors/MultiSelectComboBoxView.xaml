<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.MultiSelectComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:MultiSelectComboBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Interactive (use the side panel)">
                    <StackPanel Margin="10">
                        <atc:MultiSelectComboBox
                            x:Name="InteractiveBox"
                            Width="220"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Source systems"
                            AutomationProperties.AutomationId="InteractiveBox"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            Items="{Binding Path=SourceSystems}"
                            MaxNamesInSummary="{Binding Path=MaxNamesInSummary}"
                            NoneText="{Binding Path=NoneText}"
                            ShowClearButton="{Binding Path=ShowClearButton}"
                            ShowSelectAllRow="{Binding Path=ShowSelectAllRow}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per tick, Select all or Clear):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Toolbar  -->
                <atc:GroupBoxExpander Header="In a toolbar (same height as the other toolbar items)">
                    <ToolBarTray Margin="10" HorizontalAlignment="Left">
                        <ToolBar>
                            <Button Content="Refresh" />
                            <Separator Margin="5,0" />
                            <ComboBox Width="140" SelectedIndex="0">
                                <ComboBoxItem Content="Last hour" />
                                <ComboBoxItem Content="Today" />
                            </ComboBox>
                            <Separator Margin="5,0" />
                            <atc:MultiSelectComboBox
                                Width="200"
                                atc:TextBoxHelper.Watermark="Log levels"
                                Items="{Binding Path=LogLevels}"
                                SelectedKeys="{Binding Path=SelectedLogLevels}" />
                            <Separator Margin="5,0" />
                            <TextBox Width="150" Text="Search" />
                        </ToolBar>
                    </ToolBarTray>
                </atc:GroupBoxExpander>

                <!--  Live data  -->
                <atc:GroupBoxExpander Header="Live data: new source systems are ticked (SelectNewItems), removed ones are unticked">
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <atc:MultiSelectComboBox
                            Width="220"
                            atc:TextBoxHelper.Watermark="Source systems"
                            Items="{Binding Path=LiveSourceSystems}"
                            SelectNewItems="True"
                            SelectedKeys="{Binding Path=SelectedLiveSourceSystems}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding Path=AddSourceSystemCommand}"
                            Content="Add a source system" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding Path=RemoveFirstSourceSystemCommand}"
                            Content="Remove the first one" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Summary texts  -->
                <atc:GroupBoxExpander Header="Summary texts: names, count, All, None">
                    <WrapPanel Margin="10">
                        <atc:MultiSelectComboBox
                            Width="200"
                            Margin="0,0,10,0"
                            Items="{Binding Path=SourceSystems}"
                            NoneText="No source system" />
                        <atc:MultiSelectComboBox
                            Width="200"
                            Margin="0,0,10,0"
                            AllText="Every source system"
                            Items="{Binding Path=SourceSystems}"
                            SelectedKeys="{Binding Path=SelectedAllSourceSystems}" />
                        <atc:MultiSelectComboBox
                            Width="200"
                            CountFormat="{}{0}/{1} countries"
                            Items="{Binding Path=Countries}"
                            SelectedKeys="{Binding Path=SelectedCountries}" />
                    </WrapPanel>
                </atc:GroupBoxExpander>

                <!--  1,000 items  -->
                <atc:GroupBoxExpander Header="1,000 items with filter (virtualized)">
                    <atc:MultiSelectComboBox
                        Width="220"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick items"
                        Items="{Binding Path=ManyItems}"
                        MaxDropDownHeight="320" />
                </atc:GroupBoxExpander>

                <!--  Disabled  -->
                <atc:GroupBoxExpander Header="Disabled">
                    <atc:MultiSelectComboBox
                        Width="220"
                        Margin="10"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Items="{Binding Path=LogLevels}"
                        SelectedKeys="{Binding Path=SelectedLogLevels}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>