<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.CheckListBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:CheckListBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Interactive (use the side panel)">
                    <StackPanel Margin="10">
                        <Border
                            Width="300"
                            HorizontalAlignment="Left"
                            BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                            BorderThickness="1">
                            <atc:CheckListBox
                                x:Name="InteractiveBox"
                                AutomationProperties.AutomationId="InteractiveBox"
                                IsEnabled="{Binding Path=IsControlEnabled}"
                                ItemStyle="{Binding Path=ItemStyle}"
                                Items="{Binding Path=Fruits}"
                                ShowClearButton="{Binding Path=ShowClearButton}"
                                ShowSelectAllRow="{Binding Path=ShowSelectAllRow}" />
                        </Border>
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per tick, Select all, Clear, group or range):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Columns to export  -->
                <atc:GroupBoxExpander Header="Columns to export (check boxes, Select all, Clear)">
                    <Border
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <atc:CheckListBox
                            Items="{Binding Path=ExportColumns}"
                            SelectedKeys="{Binding Path=SelectedExportColumns}"
                            ShowClearButton="True" />
                    </Border>
                </atc:GroupBoxExpander>

                <!--  Notification settings  -->
                <atc:GroupBoxExpander Header="Notification settings (Switch style, no Select all row)">
                    <Border
                        Width="360"
                        Margin="10"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <atc:CheckListBox
                            ItemStyle="Switch"
                            Items="{Binding Path=Notifications}"
                            SelectedKeys="{Binding Path=SelectedNotifications}"
                            ShowSelectAllRow="False" />
                    </Border>
                </atc:GroupBoxExpander>

                <!--  Grouped permissions  -->
                <atc:GroupBoxExpander Header="Grouped permissions (tri-state group headers; Read users is locked)">
                    <Border
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <atc:CheckListBox
                            DisabledKeys="{Binding Path=LockedPermissions}"
                            ItemGroups="{Binding Path=PermissionGroups}"
                            Items="{Binding Path=Permissions}"
                            SelectedKeys="{Binding Path=SelectedPermissions}" />
                    </Border>
                </atc:GroupBoxExpander>

                <!--  Highlight style and a limit  -->
                <atc:GroupBoxExpander Header="Highlight style with a limit of 3">
                    <Border
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <atc:CheckListBox
                            ItemStyle="Highlight"
                            Items="{Binding Path=ExportColumns}"
                            MaxSelectionCount="3" />
                    </Border>
                </atc:GroupBoxExpander>

                <!--  Columns  -->
                <atc:GroupBoxExpander Header="Months in 3 columns">
                    <Border
                        Width="420"
                        Margin="10"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <atc:CheckListBox
                            Columns="3"
                            IsFilterVisible="False"
                            Items="{Binding Path=Months}" />
                    </Border>
                </atc:GroupBoxExpander>

                <!--  10,000 items  -->
                <atc:GroupBoxExpander Header="10,000 items with filter (virtualized)">
                    <Border
                        Width="300"
                        Height="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource AtcApps.Brushes.Control.Border}"
                        BorderThickness="1">
                        <atc:CheckListBox Items="{Binding Path=ManyItems}" />
                    </Border>
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>