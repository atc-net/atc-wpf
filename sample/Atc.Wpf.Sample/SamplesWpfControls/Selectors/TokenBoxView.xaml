<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.TokenBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:TokenBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Known list (use the side panel)">
                    <StackPanel Margin="10">
                        <atc:TokenBox
                            x:Name="InteractiveBox"
                            Width="320"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Source systems"
                            AllowCreate="{Binding Path=AllowCreate}"
                            AutomationProperties.AutomationId="InteractiveBox"
                            FilterMode="{Binding Path=FilterMode}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            Items="{Binding Path=SourceSystems}"
                            MinimumPrefixLength="{Binding Path=MinimumPrefixLength}"
                            ShowClearButton="{Binding Path=ShowClearButton}"
                            TokensWrap="{Binding Path=TokensWrap}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per pick, removal, paste or Clear):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Free tags  -->
                <atc:GroupBoxExpander Header="Free tags: AllowCreate, at most 10, double-click a new tag to edit it, Clear button">
                    <StackPanel Margin="10">
                        <atc:TokenBox
                            x:Name="TagsBox"
                            Width="320"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Add tags"
                            AllowCreate="True"
                            AllowEditTokens="True"
                            AutomationProperties.AutomationId="TagsBox"
                            Items="{Binding Path=KnownTags}"
                            MaxSelectionCount="10"
                            SelectedKeys="{Binding Path=Tags}"
                            ShowClearButton="True" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Opacity="0.7"
                            Text="Type a tag and press Enter, Tab, ',' or ';'. Paste &quot;a; b, c&quot; (or lines from Excel) to add several at once."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TagsLog"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Validation  -->
                <atc:GroupBoxExpander Header="E-mail addresses: CreateValidator refuses values without '@'">
                    <atc:TokenBox
                        Width="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Recipients"
                        AllowCreate="True"
                        CreateValidator="{Binding Path=ValidateEmail}"
                        SelectedKeys="{Binding Path=Emails}" />
                </atc:GroupBoxExpander>

                <!--  Async lookup  -->
                <atc:GroupBoxExpander Header="Async lookup of 10,000 users (SuggestionsProvider, 400 ms simulated latency)">
                    <StackPanel Margin="10">
                        <atc:TokenBox
                            Width="320"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Assign people (try &quot;jen&quot;)"
                            MaxDropDownHeight="300"
                            SelectedKeys="{Binding Path=AssignedUsers}"
                            SuggestionsProvider="{Binding Path=LookupUsers}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Opacity="0.7"
                            Text="Typing waits 250 ms (SuggestionDelay) before the lookup runs; each keystroke cancels the previous lookup."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  One line vs wrap  -->
                <atc:GroupBoxExpander Header="One line vs wrap (MaxVisibleTokens = 3 when not focused)">
                    <StackPanel Margin="10">
                        <TextBlock Text="TokensWrap = False: one line; scrolls while focused, '+N' when not" />
                        <atc:TokenBox
                            Width="320"
                            Margin="0,4,0,10"
                            HorizontalAlignment="Left"
                            Items="{Binding Path=Countries}"
                            SelectedKeys="{Binding Path=OneLineCountries}"
                            TokensWrap="False" />
                        <TextBlock Text="TokensWrap = True (default) with MaxVisibleTokens = 3: grows in height while focused" />
                        <atc:TokenBox
                            Width="320"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Items="{Binding Path=Countries}"
                            MaxVisibleTokens="3"
                            SelectedKeys="{Binding Path=WrapCountries}" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Fixed keys  -->
                <atc:GroupBoxExpander Header="Fixed tokens (FixedKeys: no remove button; Backspace and Clear skip them)">
                    <atc:TokenBox
                        Width="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        FixedKeys="{Binding Path=FixedSourceSystems}"
                        Items="{Binding Path=SourceSystems}"
                        SelectedKeys="{Binding Path=SelectedFixedSourceSystems}"
                        ShowClearButton="True" />
                </atc:GroupBoxExpander>

                <!--  Disabled  -->
                <atc:GroupBoxExpander Header="Disabled">
                    <atc:TokenBox
                        Width="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Items="{Binding Path=SourceSystems}"
                        SelectedKeys="{Binding Path=SelectedFixedSourceSystems}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>