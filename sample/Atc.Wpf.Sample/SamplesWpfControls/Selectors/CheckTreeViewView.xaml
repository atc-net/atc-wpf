<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.CheckTreeViewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:CheckTreeViewDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Permissions (use the side panel; Parents strategy: a whole module is one key)">
                    <StackPanel Margin="10">
                        <atc:CheckTreeView
                            x:Name="InteractiveBox"
                            Width="360"
                            Height="300"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="InteractiveBox"
                            CheckedKeysStrategy="{Binding Path=CheckedKeysStrategy}"
                            FilterMode="{Binding Path=FilterMode}"
                            IsCheckLinked="{Binding Path=IsCheckLinked}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            IsFilterVisible="True"
                            Nodes="{Binding Path=Permissions}"
                            SelectedKeys="{Binding Path=PermissionKeys}"
                            ShowSelectAllRow="{Binding Path=ShowSelectAllRow}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Opacity="0.7"
                            Text="'Impersonate users' is disabled: it keeps its state, so 'Users' stays partial when ticked."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per tick, Select all or Clear):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Lazy loading  -->
                <atc:GroupBoxExpander Header="Lazy file system (LoadChildrenAsync, 600 ms per folder; a ticked folder passes its tick on)">
                    <StackPanel Margin="10">
                        <atc:CheckTreeView
                            x:Name="DrivesTree"
                            Width="360"
                            Height="260"
                            HorizontalAlignment="Left"
                            CheckedKeysStrategy="Parents"
                            ExpandDepth="0"
                            LoadChildrenAsync="{Binding Path=LoadFolder}"
                            Nodes="{Binding Path=Drives}"
                            SelectedKeys="{Binding Path=DriveKeys}" />
                        <TextBlock
                            x:Name="DrivesLog"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Large tree  -->
                <atc:GroupBoxExpander Header="10,000 nodes in 3 levels (virtualized; try the filter, FilterMode = FlatResults)">
                    <atc:CheckTreeView
                        Width="360"
                        Height="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        FilterMode="FlatResults"
                        Nodes="{Binding Path=Catalog}"
                        SelectedKeys="{Binding Path=CatalogKeys}"
                        ShowSelectAllRow="True" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>