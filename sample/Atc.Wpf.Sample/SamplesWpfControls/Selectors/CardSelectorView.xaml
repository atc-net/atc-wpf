<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.CardSelectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:CardSelectorDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Icon, title and description  -->
        <DataTemplate x:Key="ModuleCardTemplate" DataType="{x:Type local:CardOption}">
            <StackPanel AutomationProperties.Name="{Binding Path=Title}">
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="22"
                    Foreground="{DynamicResource AtcApps.Brushes.Accent}"
                    Text="{Binding Path=Glyph}" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontWeight="SemiBold"
                    Text="{Binding Path=Title}" />
                <TextBlock
                    Margin="0,2,0,0"
                    Opacity="0.75"
                    Text="{Binding Path=Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!--  Thumbnail on top  -->
        <DataTemplate x:Key="ReportCardTemplate" DataType="{x:Type local:CardOption}">
            <StackPanel AutomationProperties.Name="{Binding Path=Title}">
                <Border
                    Height="72"
                    Background="{DynamicResource AtcApps.Brushes.Accent4}"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="32"
                        Foreground="{DynamicResource AtcApps.Brushes.Accent}"
                        Text="{Binding Path=Glyph}" />
                </Border>
                <TextBlock
                    Margin="0,8,0,0"
                    FontWeight="SemiBold"
                    Text="{Binding Path=Title}" />
                <TextBlock
                    Opacity="0.75"
                    Text="{Binding Path=Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!--  Plan with a price  -->
        <DataTemplate x:Key="PlanCardTemplate" DataType="{x:Type local:CardOption}">
            <StackPanel AutomationProperties.Name="{Binding Path=Title}">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding Path=Title}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="20"
                    Foreground="{DynamicResource AtcApps.Brushes.Accent}"
                    Text="{Binding Path=Price}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.75"
                    Text="{Binding Path=Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!--  Device with a status  -->
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type local:CardOption}">
            <DockPanel AutomationProperties.Name="{Binding Path=Title}">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="24"
                    Text="{Binding Path=Glyph}" />
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Path=Title}" />
                    <TextBlock Opacity="0.75" Text="{Binding Path=Description}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

    </UserControl.Resources>

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Interactive (use the side panel)">
                    <StackPanel Margin="10">
                        <atc:CardSelector
                            x:Name="InteractiveBox"
                            AutomationProperties.AutomationId="InteractiveBox"
                            AutomationProperties.Name="Modules"
                            CardWidth="{Binding Path=CardWidth}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            ItemSpacing="{Binding Path=ItemSpacing}"
                            ItemTemplate="{StaticResource ModuleCardTemplate}"
                            ItemsSource="{Binding Path=Modules}"
                            KeyMemberPath="Id"
                            SelectedKeys="{Binding Path=SelectedModules}"
                            SelectionMode="{Binding Path=SelectionMode}"
                            ShowCheckMark="{Binding Path=ShowCheckMark}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per card toggle, Ctrl+A or clear):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Report templates  -->
                <atc:GroupBoxExpander Header="Report templates (multiple, thumbnails)">
                    <atc:CardSelector
                        Margin="10"
                        AutomationProperties.Name="Report templates"
                        CardWidth="200"
                        ItemTemplate="{StaticResource ReportCardTemplate}"
                        ItemsSource="{Binding Path=ReportTemplates}"
                        KeyMemberPath="Id"
                        SelectedKeys="{Binding Path=SelectedReportTemplates}" />
                </atc:GroupBoxExpander>

                <!--  Plan picker  -->
                <atc:GroupBoxExpander Header="Plan picker (single - arrow keys move and select)">
                    <atc:CardSelector
                        Margin="10"
                        AutomationProperties.AutomationId="PlanPicker"
                        AutomationProperties.Name="Plans"
                        CardWidth="200"
                        ItemTemplate="{StaticResource PlanCardTemplate}"
                        ItemsSource="{Binding Path=Plans}"
                        KeyMemberPath="Id"
                        SelectedKeys="{Binding Path=SelectedPlans}"
                        SelectionMode="Single" />
                </atc:GroupBoxExpander>

                <!--  Device picker  -->
                <atc:GroupBoxExpander Header="Device picker (offline devices are disabled, at most 2)">
                    <atc:CardSelector
                        Margin="10"
                        AutomationProperties.AutomationId="DevicePicker"
                        AutomationProperties.Name="Devices"
                        CardWidth="220"
                        IsEnabledMemberPath="IsAvailable"
                        ItemTemplate="{StaticResource DeviceCardTemplate}"
                        ItemsSource="{Binding Path=Devices}"
                        KeyMemberPath="Id"
                        MaxSelectionCount="2"
                        SelectedKeys="{Binding Path=SelectedDevices}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>