<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.CascaderComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:CascaderComboBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Regions: country › region › city (click mode, chips with the full path; use the side panel)">
                    <StackPanel Margin="10">
                        <atc:CascaderComboBox
                            x:Name="InteractiveBox"
                            Width="360"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Pick regions"
                            AutomationProperties.AutomationId="InteractiveBox"
                            CheckedKeysStrategy="{Binding Path=CheckedKeysStrategy}"
                            ColumnWidth="{Binding Path=ColumnWidth}"
                            DisplayMode="{Binding Path=DisplayMode}"
                            ExpandTrigger="{Binding Path=ExpandTrigger}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            MaxDropDownHeight="320"
                            Nodes="{Binding Path=Regions}"
                            SelectedKeys="{Binding Path=RegionKeys}"
                            ShowFullPath="{Binding Path=ShowFullPath}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per tick or chip removal):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Hover  -->
                <atc:GroupBoxExpander Header="Product categories: hover mode (resting on a row opens the next column), Leaves strategy">
                    <atc:CascaderComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick products"
                        CheckedKeysStrategy="Leaves"
                        ExpandTrigger="Hover"
                        Nodes="{Binding Path=Products}"
                        SelectedKeys="{Binding Path=ProductKeys}" />
                </atc:GroupBoxExpander>

                <!--  Lazy  -->
                <atc:GroupBoxExpander Header="Lazy loading: site › building › room (LoadChildrenAsync, 700 ms per level)">
                    <atc:CascaderComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Pick rooms"
                        DisplayMode="Chips"
                        LoadChildrenAsync="{Binding Path=LoadSiteChildren}"
                        Nodes="{Binding Path=Sites}"
                        SelectedKeys="{Binding Path=SiteKeys}"
                        ShowFullPath="True" />
                </atc:GroupBoxExpander>

                <!--  Limit  -->
                <atc:GroupBoxExpander Header="At most 3 keys, count summary, custom path separator">
                    <atc:CascaderComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        CheckedKeysStrategy="Leaves"
                        DisplayMode="Count"
                        MaxSelectionCount="3"
                        Nodes="{Binding Path=LimitRegions}"
                        PathSeparator=" › "
                        SelectedKeys="{Binding Path=LimitRegionKeys}" />
                </atc:GroupBoxExpander>

                <!--  Disabled  -->
                <atc:GroupBoxExpander Header="Disabled">
                    <atc:CascaderComboBox
                        Width="300"
                        Margin="10"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Nodes="{Binding Path=DisabledRegions}"
                        SelectedKeys="{Binding Path=DisabledRegionKeys}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>
