<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfControls.Selectors.TreeSelectComboBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Atc.Wpf.Sample.SamplesWpfControls.Selectors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=local:TreeSelectComboBoxDemoViewModel}"
    d:DesignHeight="900"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <!--  Interactive demo  -->
                <atc:GroupBoxExpander Header="Regions (use the side panel; Leaves strategy: only sites are keys)">
                    <StackPanel Margin="10">
                        <atc:TreeSelectComboBox
                            x:Name="InteractiveBox"
                            Width="260"
                            HorizontalAlignment="Left"
                            atc:TextBoxHelper.Watermark="Sales regions"
                            AutomationProperties.AutomationId="InteractiveBox"
                            CheckedKeysStrategy="{Binding Path=CheckedKeysStrategy}"
                            DisplayMode="{Binding Path=DisplayMode}"
                            FilterMode="{Binding Path=FilterMode}"
                            IsEnabled="{Binding Path=IsControlEnabled}"
                            MaxDropDownHeight="360"
                            MaxNamesInSummary="{Binding Path=MaxNamesInSummary}"
                            Nodes="{Binding Path=Regions}"
                            SelectedKeys="{Binding Path=RegionKeys}"
                            ShowSelectAllRow="{Binding Path=ShowSelectAllRow}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="Bold"
                            Text="SelectedKeysChanged events (one line per tick, Select all, Clear or chip removal):" />
                        <TextBlock
                            x:Name="SelectedKeysLog"
                            AutomationProperties.AutomationId="SelectedKeysLog"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </atc:GroupBoxExpander>

                <!--  Chips  -->
                <atc:GroupBoxExpander Header="Chips with the Parents strategy (one chip for a whole country)">
                    <atc:TreeSelectComboBox
                        Width="320"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Regions"
                        CheckedKeysStrategy="Parents"
                        DisplayMode="Chips"
                        Nodes="{Binding Path=ChipRegions}"
                        SelectedKeys="{Binding Path=ChipRegionKeys}"
                        ShowSelectAllRow="True" />
                </atc:GroupBoxExpander>

                <!--  Count  -->
                <atc:GroupBoxExpander Header="Count summary, filter always shown, FlatResults">
                    <atc:TreeSelectComboBox
                        Width="260"
                        Margin="10"
                        HorizontalAlignment="Left"
                        CheckedKeysStrategy="Parents"
                        DisplayMode="Count"
                        FilterMode="FlatResults"
                        IsFilterVisible="True"
                        Nodes="{Binding Path=Permissions}"
                        SelectedKeys="{Binding Path=PermissionKeys}" />
                </atc:GroupBoxExpander>

                <!--  Lazy  -->
                <atc:GroupBoxExpander Header="Lazy file system in a drop-down (LoadChildrenAsync)">
                    <atc:TreeSelectComboBox
                        Width="260"
                        Margin="10"
                        HorizontalAlignment="Left"
                        atc:TextBoxHelper.Watermark="Folders to back up"
                        CheckedKeysStrategy="Parents"
                        ExpandDepth="0"
                        LoadChildrenAsync="{Binding Path=LoadFolder}"
                        Nodes="{Binding Path=Drives}"
                        SelectedKeys="{Binding Path=DriveKeys}" />
                </atc:GroupBoxExpander>

                <!--  Disabled  -->
                <atc:GroupBoxExpander Header="Disabled">
                    <atc:TreeSelectComboBox
                        Width="260"
                        Margin="10"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Nodes="{Binding Path=DisabledRegions}"
                        SelectedKeys="{Binding Path=DisabledRegionKeys}" />
                </atc:GroupBoxExpander>

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />
    </atc:GridEx>

</UserControl>