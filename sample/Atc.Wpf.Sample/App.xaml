<atcSample:SampleApplication
    x:Class="Atc.Wpf.Sample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcSample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    Exit="ApplicationExit"
    ShutdownOnUnhandledException="True"
    Startup="ApplicationStartup"
    TraceBindingErrorsVariable="ATC_WPF_SAMPLE_TRACE_BINDING_ERRORS">
    <Application.Resources>
        <ResourceDictionary>

            <!--  The Atc style dictionaries are merged by SampleApplication at start-up  -->

            <Style x:Key="SampleScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
            </Style>

            <Style x:Key="SampleUsageAreaStyle" TargetType="{x:Type atc:UniformSpacingPanel}">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Spacing" Value="20" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</atcSample:SampleApplication>