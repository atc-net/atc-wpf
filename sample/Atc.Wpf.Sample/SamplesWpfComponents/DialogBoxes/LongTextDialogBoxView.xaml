<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfComponents.DialogBoxes.LongTextDialogBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogBoxes="clr-namespace:Atc.Wpf.Sample.SamplesWpfComponents.DialogBoxes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=dialogBoxes:LongTextDialogBoxViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Text">
                    <atc:UniformSpacingPanel
                        Margin="10"
                        Orientation="Vertical"
                        Spacing="10">
                        <atc:ThemeSelector x:Name="LongTextThemeSelector" />
                        <ComboBox
                            AutomationProperties.AutomationId="LongTextKind"
                            ItemsSource="{Binding Path=TextKinds}"
                            SelectedItem="{Binding Path=SelectedTextKind}" />
                        <CheckBox
                            AutomationProperties.AutomationId="LongTextNarrow"
                            Content="Narrow dialog (350 instead of the default 500)"
                            IsChecked="{Binding Path=UseNarrowDialog}" />
                        <CheckBox
                            AutomationProperties.AutomationId="LongTextRightToLeft"
                            Content="Right to left"
                            IsChecked="{Binding Path=IsRightToLeft}" />
                        <CheckBox
                            AutomationProperties.AutomationId="LongTextAutoHeight"
                            Content="Auto height (dialogs created with settings)"
                            IsChecked="{Binding Path=AutoHeight}" />
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="InfoDialogBox - one per icon">
                    <ItemsControl Margin="10" ItemsSource="{Binding Path=InfoIcons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    MinWidth="90"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="{Binding StringFormat='LongTextInfo{0}'}"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ShowInfoCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="Other dialogs">
                    <WrapPanel Margin="10">
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextInfoWithHeader"
                            Command="{Binding Path=ShowInfoWithHeaderCommand}"
                            Content="Info with header" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextQuestionText"
                            Command="{Binding Path=ShowQuestionCommand}"
                            CommandParameter="Text"
                            Content="Question" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextQuestionTitle"
                            Command="{Binding Path=ShowQuestionCommand}"
                            CommandParameter="Title"
                            Content="Question with title" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextQuestionHeader"
                            Command="{Binding Path=ShowQuestionCommand}"
                            CommandParameter="Header"
                            Content="Question with header" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextQuestionSettings"
                            Command="{Binding Path=ShowQuestionCommand}"
                            CommandParameter="Settings"
                            Content="Question with settings" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextInput"
                            Command="{Binding Path=ShowInputCommand}"
                            Content="Input" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextInputForm"
                            Command="{Binding Path=ShowInputFormCommand}"
                            Content="Input form" />
                        <Button
                            MinWidth="140"
                            Margin="0,0,10,10"
                            AutomationProperties.AutomationId="LongTextColorPicker"
                            Command="{Binding Path=ShowColorPickerCommand}"
                            Content="Color picker" />
                    </WrapPanel>
                </GroupBox>

                <TextBlock AutomationProperties.AutomationId="LongTextResult" Text="{Binding Path=Result}" />

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>
