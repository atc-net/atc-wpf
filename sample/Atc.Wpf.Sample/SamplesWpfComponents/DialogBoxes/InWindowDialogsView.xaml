<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfComponents.DialogBoxes.InWindowDialogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogBoxes="clr-namespace:Atc.Wpf.Sample.SamplesWpfComponents.DialogBoxes"
    xmlns:flyouts="clr-namespace:Atc.Wpf.Components.Flyouts;assembly=Atc.Wpf.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=dialogBoxes:InWindowDialogsViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <Grid Grid.Column="0">

            <ScrollViewer Style="{StaticResource SampleScrollViewerStyle}">
                <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                    <GroupBox Header="Dialogs inside the window">
                        <atc:UniformSpacingPanel
                            Margin="10"
                            Orientation="Vertical"
                            Spacing="10">
                            <TextBlock TextWrapping="Wrap" Text="InWindowDialogService shows the standard dialogs as centred modal flyouts in this view's FlyoutHost instead of as separate windows. It implements IDialogService, so a view model awaits it exactly like the windowed DialogService." />
                            <WrapPanel>
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowInformation"
                                    Command="{Binding Path=ShowInformationCommand}"
                                    Content="Information" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowWarning"
                                    Command="{Binding Path=ShowWarningCommand}"
                                    Content="Warning" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowError"
                                    Command="{Binding Path=ShowErrorCommand}"
                                    Content="Error" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowConfirmation"
                                    Command="{Binding Path=ShowConfirmationCommand}"
                                    Content="Confirmation (Yes/No)" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowConfirmationNoIsDefault"
                                    Command="{Binding Path=ShowConfirmationNoIsDefaultCommand}"
                                    Content="Confirmation (No is default)" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowOkCancel"
                                    Command="{Binding Path=ShowOkCancelCommand}"
                                    Content="OK / Cancel" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowInput"
                                    Command="{Binding Path=ShowInputCommand}"
                                    Content="Text input" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowInputForm"
                                    Command="{Binding Path=ShowInputFormCommand}"
                                    Content="Input form" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowColorPicker"
                                    Command="{Binding Path=ShowColorPickerCommand}"
                                    Content="Colour picker" />
                                <Button
                                    MinWidth="160"
                                    Margin="0,0,10,10"
                                    AutomationProperties.AutomationId="InWindowShowFontPicker"
                                    Command="{Binding Path=ShowFontPickerCommand}"
                                    Content="Font picker" />
                            </WrapPanel>
                        </atc:UniformSpacingPanel>
                    </GroupBox>

                    <TextBlock
                        AutomationProperties.AutomationId="InWindowDialogResult"
                        Text="{Binding Path=Result}"
                        TextWrapping="Wrap" />

                </atc:UniformSpacingPanel>
            </ScrollViewer>

            <!--  The dialogs are shown here, over the view.  -->
            <flyouts:FlyoutHost x:Name="DialogHost" />

        </Grid>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>
