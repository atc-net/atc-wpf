<UserControl
    x:Class="Atc.Wpf.Sample.SamplesWpfComponents.DialogBoxes.ExceptionDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogBoxes="clr-namespace:Atc.Wpf.Sample.SamplesWpfComponents.DialogBoxes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DataContext="{d:DesignInstance Type=dialogBoxes:ExceptionDialogViewModel}"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <atc:GridEx Columns="*,400">

        <ScrollViewer Grid.Column="0" Style="{StaticResource SampleScrollViewerStyle}">
            <atc:UniformSpacingPanel x:Name="UsageArea" Style="{StaticResource SampleUsageAreaStyle}">

                <GroupBox Header="Show an exception">
                    <atc:UniformSpacingPanel
                        Margin="10"
                        Orientation="Vertical"
                        Spacing="10">
                        <TextBlock TextWrapping="Wrap" Text="The themed dialog shows the messages, with the full report (stack traces, app, OS and .NET versions) under Details. Ctrl+C or the copy button copies it, for example for an AI agent. The report is also saved to a file." />
                        <WrapPanel>
                            <Button
                                MinWidth="200"
                                Margin="0,0,10,10"
                                AutomationProperties.AutomationId="ExceptionSampleShowDialog"
                                Command="{Binding Path=ShowExceptionDialogCommand}"
                                Content="Show exception dialog" />
                            <Button
                                MinWidth="200"
                                Margin="0,0,10,10"
                                AutomationProperties.AutomationId="ExceptionSampleShowNative"
                                Command="{Binding Path=ShowNativeMessageBoxCommand}"
                                Content="Show native message box" />
                        </WrapPanel>
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <GroupBox Header="Throw an unhandled exception (closes the sample app)">
                    <atc:UniformSpacingPanel
                        Margin="10"
                        Orientation="Vertical"
                        Spacing="10">
                        <TextBlock TextWrapping="Wrap" Text="These exceptions are not caught, so the handlers in the sample app's App.xaml.cs run, as in a real app. Both buttons ask first." />
                        <WrapPanel>
                            <Button
                                MinWidth="200"
                                Margin="0,0,10,10"
                                AutomationProperties.AutomationId="ExceptionSampleThrowUi"
                                Command="{Binding Path=ThrowOnUiThreadCommand}"
                                Content="Throw on the UI thread" />
                            <Button
                                MinWidth="200"
                                Margin="0,0,10,10"
                                AutomationProperties.AutomationId="ExceptionSampleThrowBackground"
                                Command="{Binding Path=ThrowOnBackgroundThreadCommand}"
                                Content="Throw on a background thread" />
                        </WrapPanel>
                    </atc:UniformSpacingPanel>
                </GroupBox>

                <TextBlock
                    AutomationProperties.AutomationId="ExceptionSampleResult"
                    Text="{Binding Path=Result}"
                    TextWrapping="Wrap" />

            </atc:UniformSpacingPanel>
        </ScrollViewer>

        <sample:SampleSidePanel Grid.Column="1" SourceObject="{Binding}" />

    </atc:GridEx>

</UserControl>