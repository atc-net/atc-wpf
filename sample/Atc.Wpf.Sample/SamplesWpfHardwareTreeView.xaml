<TreeView
    x:Class="Atc.Wpf.Sample.SamplesWpfHardwareTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sample="clr-namespace:Atc.Wpf.Controls.Sample;assembly=Atc.Wpf.Controls.Sample"
    d:DesignHeight="450"
    d:DesignWidth="230"
    mc:Ignorable="d">

    <TreeViewItem Header="Hardware">
        <TreeViewItem Header="Demos" IsExpanded="True">
            <sample:SampleTreeViewItem
                Header="Hot-plug &amp; In-Use"
                SamplePath="Demos.HotPlugInUseDemoView" />
        </TreeViewItem>
        <TreeViewItem Header="Pickers" IsExpanded="True">
            <sample:SampleTreeViewItem
                Header="SerialPortPicker"
                SamplePath="Pickers.SerialPortPickerView" />
            <sample:SampleTreeViewItem
                Header="UsbPortPicker"
                SamplePath="Pickers.UsbPortPickerView" />
            <sample:SampleTreeViewItem
                Header="UsbCameraPicker"
                SamplePath="Pickers.UsbCameraPickerView" />
            <sample:SampleTreeViewItem
                Header="AudioInputPicker"
                SamplePath="Pickers.AudioInputPickerView" />
            <sample:SampleTreeViewItem
                Header="AudioOutputPicker"
                SamplePath="Pickers.AudioOutputPickerView" />
            <sample:SampleTreeViewItem
                Header="DrivePicker"
                SamplePath="Pickers.DrivePickerView" />
            <sample:SampleTreeViewItem
                Header="BluetoothDevicePicker"
                SamplePath="Pickers.BluetoothDevicePickerView" />
            <sample:SampleTreeViewItem
                Header="ProcessPicker"
                SamplePath="Pickers.ProcessPickerView" />
            <sample:SampleTreeViewItem
                Header="WindowPicker"
                SamplePath="Pickers.WindowPickerView" />
            <sample:SampleTreeViewItem
                Header="NetworkAdapterPicker"
                SamplePath="Pickers.NetworkAdapterPickerView" />
            <sample:SampleTreeViewItem
                Header="PrinterPicker"
                SamplePath="Pickers.PrinterPickerView" />
            <sample:SampleTreeViewItem
                Header="DisplayPicker"
                SamplePath="Pickers.DisplayPickerView" />
        </TreeViewItem>
        <TreeViewItem Header="LabelControls">
            <sample:SampleTreeViewItem
                Header="LabelSerialPortPicker"
                SamplePath="LabelControls.LabelSerialPortPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelUsbPortPicker"
                SamplePath="LabelControls.LabelUsbPortPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelUsbCameraPicker"
                SamplePath="LabelControls.LabelUsbCameraPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelAudioInputPicker"
                SamplePath="LabelControls.LabelAudioInputPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelAudioOutputPicker"
                SamplePath="LabelControls.LabelAudioOutputPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelDrivePicker"
                SamplePath="LabelControls.LabelDrivePickerView" />
            <sample:SampleTreeViewItem
                Header="LabelBluetoothDevicePicker"
                SamplePath="LabelControls.LabelBluetoothDevicePickerView" />
            <sample:SampleTreeViewItem
                Header="LabelProcessPicker"
                SamplePath="LabelControls.LabelProcessPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelWindowPicker"
                SamplePath="LabelControls.LabelWindowPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelNetworkAdapterPicker"
                SamplePath="LabelControls.LabelNetworkAdapterPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelPrinterPicker"
                SamplePath="LabelControls.LabelPrinterPickerView" />
            <sample:SampleTreeViewItem
                Header="LabelDisplayPicker"
                SamplePath="LabelControls.LabelDisplayPickerView" />
        </TreeViewItem>
    </TreeViewItem>

</TreeView>
